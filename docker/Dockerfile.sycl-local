# Self-contained SYCL/oneAPI build of llama.cpp from THIS project's own
# patched local source tree (src/llama.cpp/), not a fresh clone of vanilla
# upstream.
#
# Why this exists alongside Dockerfile.sycl: that file (see its own header)
# intentionally builds unmodified upstream at a pinned commit -- it is the
# "reproduce from patches/llama.cpp.patch" recipe, and production actually
# runs it with staging/devbin (built incrementally via devbuild.sh from this
# same src/llama.cpp/ tree) bind-mounted over its baked-in binaries, because
# the image's own binary is stale the moment any local patch changes. This
# file instead COPies src/llama.cpp/ directly, so the resulting image's own
# baked-in llama-server is current and correct with no bind-mount required
# -- e.g. for pushing a real, runnable artifact to a registry.
#
# Build from the repo root so src/llama.cpp/ is in the build context:
#   docker build -f docker/Dockerfile.sycl-local -t <tag> .
# src/llama.cpp/ must exist locally (gitignored, not part of this repo's own
# history -- see README's "Not committed here" list) with every local patch
# already applied, which is the tree staging/work/devbuild.sh already builds
# from.

ARG ONEAPI_VERSION=2025.3.3-0-devel-ubuntu24.04
ARG LLAMA_COMMIT=6d9c82ea2bb34e277c0664b8dd3434bfb4dcfb27
ARG LLAMA_REPO=https://github.com/ggml-org/llama.cpp.git

# tools/ui is vendored straight off upstream at the pinned commit, same as
# Dockerfile.sycl -- this project's local patches never touch the web UI.
FROM docker.io/node:24 AS web
WORKDIR /app/tools/ui
ARG LLAMA_COMMIT
ARG LLAMA_REPO
RUN git init -q . && \
    git remote add origin ${LLAMA_REPO} && \
    git fetch -q --depth 1 origin ${LLAMA_COMMIT} && \
    git checkout -q FETCH_HEAD -- tools/ui && \
    mv tools/ui/* tools/ui/.[!.]* . 2>/dev/null; \
    rm -rf tools
RUN npm ci
RUN npm run build

FROM docker.io/intel/deep-learning-essentials:${ONEAPI_VERSION} AS build

ARG GGML_SYCL_F16=ON
ARG LEVEL_ZERO_VERSION=1.28.2
ARG LEVEL_ZERO_UBUNTU_VERSION=u24.04
RUN apt-get update && \
    apt-get install -y git libssl-dev wget ca-certificates && \
    cd /tmp && \
    wget -q "https://github.com/oneapi-src/level-zero/releases/download/v${LEVEL_ZERO_VERSION}/level-zero_${LEVEL_ZERO_VERSION}%2B${LEVEL_ZERO_UBUNTU_VERSION}_amd64.deb" -O level-zero.deb && \
    wget -q "https://github.com/oneapi-src/level-zero/releases/download/v${LEVEL_ZERO_VERSION}/level-zero-devel_${LEVEL_ZERO_VERSION}%2B${LEVEL_ZERO_UBUNTU_VERSION}_amd64.deb" -O level-zero-devel.deb && \
    apt-get -o Dpkg::Options::="--force-overwrite" install -y ./level-zero.deb ./level-zero-devel.deb && \
    rm -f /tmp/level-zero.deb /tmp/level-zero-devel.deb

WORKDIR /app
# The only real difference from Dockerfile.sycl: local patched source
# instead of a fresh git clone of vanilla upstream.
COPY src/llama.cpp/ /app/
RUN echo "Local patched build, base commit ${LLAMA_COMMIT} (see patches/llama.cpp.patch), built $(date -u +%Y-%m-%dT%H:%M:%SZ)" > /app/PINNED_COMMIT.txt

COPY --from=web /app/tools/ui/dist tools/ui/dist

RUN if [ "${GGML_SYCL_F16}" = "ON" ]; then \
        export OPT_SYCL_F16="-DGGML_SYCL_F16=ON" \
        && export SYCL_PROGRAM_COMPILE_OPTIONS="-cl-fp32-correctly-rounded-divide-sqrt"; \
    fi && \
    cmake -B build -DGGML_NATIVE=OFF -DGGML_SYCL=ON \
        -DCMAKE_C_COMPILER=icx -DCMAKE_CXX_COMPILER=icpx \
        -DGGML_BACKEND_DL=ON -DGGML_CPU_ALL_VARIANTS=ON \
        -DLLAMA_BUILD_TESTS=ON -DLLAMA_CURL=ON \
        ${OPT_SYCL_F16} && \
    cmake --build build --config Release -j$(nproc)

RUN mkdir -p /app/lib && find build -name "*.so*" -exec cp -P {} /app/lib \;

RUN mkdir -p /app/full \
    && cp build/bin/* /app/full \
    && cp *.py /app/full \
    && cp -r conversion /app/full \
    && cp -r gguf-py /app/full \
    && cp -r requirements /app/full \
    && cp requirements.txt /app/full \
    && cp .devops/tools.sh /app/full/tools.sh \
    && cp /app/PINNED_COMMIT.txt /app/full/PINNED_COMMIT.txt

FROM docker.io/intel/deep-learning-essentials:${ONEAPI_VERSION} AS base

# Multi-GPU-safe driver stack, matching Dockerfile.sycl exactly (see that
# file's comment for why these specific versions).
ARG IGC_VERSION=v2.34.4
ARG IGC_VERSION_FULL=2_2.34.4+21428
ARG COMPUTE_RUNTIME_VERSION=26.18.38308.1
ARG COMPUTE_RUNTIME_VERSION_FULL=26.18.38308.1-0
ARG IGDGMM_VERSION=22.10.0
RUN mkdir /tmp/neo/ && cd /tmp/neo/ \
  && wget -q https://github.com/intel/intel-graphics-compiler/releases/download/$IGC_VERSION/intel-igc-core-${IGC_VERSION_FULL}_amd64.deb \
  && wget -q https://github.com/intel/intel-graphics-compiler/releases/download/$IGC_VERSION/intel-igc-opencl-${IGC_VERSION_FULL}_amd64.deb \
  && wget -q https://github.com/intel/compute-runtime/releases/download/$COMPUTE_RUNTIME_VERSION/intel-ocloc-dbgsym_${COMPUTE_RUNTIME_VERSION_FULL}_amd64.ddeb \
  && wget -q https://github.com/intel/compute-runtime/releases/download/$COMPUTE_RUNTIME_VERSION/intel-ocloc_${COMPUTE_RUNTIME_VERSION_FULL}_amd64.deb \
  && wget -q https://github.com/intel/compute-runtime/releases/download/$COMPUTE_RUNTIME_VERSION/intel-opencl-icd-dbgsym_${COMPUTE_RUNTIME_VERSION_FULL}_amd64.ddeb \
  && wget -q https://github.com/intel/compute-runtime/releases/download/$COMPUTE_RUNTIME_VERSION/intel-opencl-icd_${COMPUTE_RUNTIME_VERSION_FULL}_amd64.deb \
  && wget -q https://github.com/intel/compute-runtime/releases/download/$COMPUTE_RUNTIME_VERSION/libigdgmm12_${IGDGMM_VERSION}_amd64.deb \
  && wget -q https://github.com/intel/compute-runtime/releases/download/$COMPUTE_RUNTIME_VERSION/libze-intel-gpu1-dbgsym_${COMPUTE_RUNTIME_VERSION_FULL}_amd64.ddeb \
  && wget -q https://github.com/intel/compute-runtime/releases/download/$COMPUTE_RUNTIME_VERSION/libze-intel-gpu1_${COMPUTE_RUNTIME_VERSION_FULL}_amd64.deb \
  && dpkg --install *.deb

RUN apt-get update \
    && apt-get install -y libgomp1 curl ffmpeg git python3 python3-pip python3-venv \
    && apt-get autoremove -y && apt-get clean -y \
    && rm -rf /tmp/* /var/tmp/* \
    && find /var/cache/apt/archives /var/lib/apt/lists -not -name lock -type f -delete \
    && find /var/cache -type f -delete

FROM base AS full

COPY --from=build /app/lib/ /app
COPY --from=build /app/full /app
WORKDIR /app

RUN python3 -m venv /opt/venv && \
    . /opt/venv/bin/activate && \
    pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt

ENV PATH="/opt/venv/bin:/app:${PATH}"
ENV GGML_SYCL_USM_SYSTEM=0
ENV LD_LIBRARY_PATH="/app:/opt/intel/oneapi/tcm/1.4/lib:/opt/intel/oneapi/umf/1.0/lib:/opt/intel/oneapi/tbb/2022.3/env/../lib/intel64/gcc4.8:/opt/intel/oneapi/pti/0.16/lib:/opt/intel/oneapi/mpi/2021.17/opt/mpi/libfabric/lib:/opt/intel/oneapi/mpi/2021.17/lib:/opt/intel/oneapi/mkl/2025.3/lib:/opt/intel/oneapi/dnnl/2025.3/lib:/opt/intel/oneapi/debugger/2025.3/opt/debugger/lib:/opt/intel/oneapi/compiler/2025.3/opt/compiler/lib:/opt/intel/oneapi/compiler/2025.3/lib:/opt/intel/oneapi/ccl/2021.17/lib/"

ENTRYPOINT ["/bin/bash"]
