+//
+// SYCL provider for the hybrid CPU/GPU MUL_MAT_ID validation spike.
+// See ggml/src/ggml-mmid-hybrid.h and
+// docs/research/05-hybrid-cpu-gpu-mul-mat-id-scoping.md sections 4.6 / 6.
+//
+#ifndef GGML_SYCL_MMID_HYBRID_HPP
+#define GGML_SYCL_MMID_HYBRID_HPP
+
+// Build the private queue and fill in the ggml_mmid_hybrid table.
+// Call once from SYCL backend init, on the thread that ran SYCL init.
+// No-op unless GGML_SYCL_MMID_HYBRID_FRACTION is set above 0.
+void ggml_sycl_mmid_hybrid_register(void);
+
+#endif // GGML_SYCL_MMID_HYBRID_HPP
diff --git a/ggml/src/ggml-sycl/moe-cache.cpp b/ggml/src/ggml-sycl/moe-cache.cpp
new file mode 100644
index 000000000..554d135a4
--- /dev/null
+++ b/ggml/src/ggml-sycl/moe-cache.cpp
@@ -0,0 +1,1005 @@
+//
+// SYCL port of GenerelSchwerz/llama.cpp's CUDA MoE expert cache -- Phase 2:
+// cold-tier pinned-host buffer type.
+//
+// Read the reference fork's ggml/src/ggml-cuda/moe-cache.cu buffer-type
+// section (~line 11040, "ggml buffer type: CUDA_MoE_Cached") before touching
+// this file. The key, easy-to-miss fact it establishes: the fork's buffer
+// type does NOT itself hold any VRAM. It is a thin relabeling of a plain
+// pinned-host CPU buffer (cudaMallocHost there, sycl::malloc_host here) with
+// exactly three deltas from the ordinary host buffer type:
+//
+//   1. A distinct get_name() identity, so callers (here: only our own future
+//      Phase-3 dispatch hook) can recognize "this tensor's cold copy lives
+//      in the MoE cache's pinned tier" via ggml_backend_buft_is_sycl_moe_cached.
+//   2. is_host() hardcoded to false. This is load-bearing, not cosmetic: if
+//      it returned true (as ggml-sycl.cpp's ordinary host buffer type does,
+//      inherited from the CPU buffer type), ggml's scheduler would treat
+//      every tensor here as CPU-backend-resident and route MUL_MAT_ID
+//      straight to the CPU backend -- completely bypassing the SYCL
+//      dispatch hook Phase 3 needs to intercept at. The fork's own comment:
+//      "We rely on CUDA reading the pinned mapping directly via
+//      cudaMemcpyAsync for the H2D copy in the dispatch hook" -- i.e. the
+//      hook does its own manual host->device copy from this buffer's
+//      pointers, bypassing the generic scheduler copy path entirely, so
+//      none of ggml-sycl.cpp's generic cpy_tensor/is_sycl/is_sycl_split
+//      branches need to learn about this buffer type. (Confirmed by reading
+//      the fork's ggml-cuda.cu: it never touches its own generic
+//      ggml_cuda_cpy_tensor_2d-equivalent for this buffer type.) That
+//      dispatch-hook work is Phase 3's job, not this file's.
+//   3. get_max_size() capped at 2 GiB, unconditionally (not gated behind the
+//      existing g_ggml_sycl_host_pinned_mem_2g flag in ggml-sycl.cpp, which
+//      serves a different, pre-existing buffer type). This is the SYCL
+//      analogue of the fork's cudaMallocHost chunking concern -- Level Zero
+//      wants host allocations to stay bounded for reliable copy/compute
+//      overlap. No custom slab->(allocation,offset) map is needed to honor
+//      this: ggml_backend_alloc_ctx_tensors_from_buft_impl (ggml/src/
+//      ggml-alloc.c) already splits a context's tensors across multiple
+//      buffers whenever the running total would exceed get_max_size(),
+//      transparently wrapping the result in a multi-buffer if there's more
+//      than one -- confirmed by reading that function directly rather than
+//      assuming it from the CUDA side (CUDA's cudaMallocHost apparently
+//      tolerates single allocations large enough that the fork never needed
+//      this at all; SYCL/Level Zero's tighter per-allocation comfort zone is
+//      exactly why docs/research/01 flagged it as SYCL-specific).
+//
+// Also read issue #25812 before writing any allocator here (per PLAN.md
+// Phase 2): a still-open SYCL bug where offloading MoE experts to Arc GPUs
+// aborts with UR_RESULT_ERROR_OUT_OF_HOST_MEMORY from what looks like an
+// oversized *single* host-side staging allocation during the per-expert
+// quant reorder step (reorder_qw_q4_k_moe / mul_mat_id_sycl) -- NOT genuine
+// host RAM exhaustion (900+ GB free in the reporter's case). That bug lives
+// in the existing static-offload reorder path, not in this new buffer type,
+// but it's a direct confirmation that "one big allocation, however much RAM
+// is technically free" is a real, live failure mode in this exact tensor
+// class on this exact backend -- reinforcing (not just theoretically
+// motivating) the <=2 GiB chunking above, and a reason to be equally
+// careful about any staging buffer Phase 3 introduces.
+
+#include "moe-cache.hpp"
+
+#include "ggml-impl.h"
+#include "ggml-backend-impl.h"
+#include "ggml-sycl.h"
+#include "common.hpp"
+#include "dpct/helper.hpp"
+
+#include <sycl/sycl.hpp>
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+#include <memory>
+#include <chrono>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+namespace {
+
+constexpr size_t k_moe_cache_max_alloc_bytes = 2ULL * 1024 * 1024 * 1024; // 2 GiB
+
+const char * moe_cached_buffer_type_name(ggml_backend_buffer_type_t buft) {
+    GGML_UNUSED(buft);
+    return GGML_SYCL_NAME "_MoE_Cached";
+}
+
+void * moe_cached_pinned_malloc(size_t size) {
+    void * ptr = nullptr;
+    try {
+        auto & q = dpct::dev_mgr::instance().get_device(0).default_queue();
+        ptr = sycl::malloc_host(size, q, sycl::property_list{});
+    } catch (...) {
+        ptr = nullptr;
+    }
+    if (ptr == nullptr) {
+        GGML_LOG_WARN("%s: failed to allocate %.2f MiB of pinned host memory for the MoE cache cold tier\n",
+                       __func__, size / 1024.0 / 1024.0);
+    }
+    return ptr;
+}
+
+void moe_cached_buffer_free_buffer(ggml_backend_buffer_t buffer) {
+    if (buffer->context == nullptr) {
+        return;
+    }
+    auto & q = dpct::dev_mgr::instance().get_device(0).default_queue();
+    sycl::free(buffer->context, q);
+}
+
+ggml_backend_buffer_t moe_cached_buffer_type_alloc_buffer(ggml_backend_buffer_type_t buft, size_t size) {
+    void * ptr = moe_cached_pinned_malloc(size);
+    if (ptr == nullptr) {
+        // Keeps the model loadable even if the pinned pool is exhausted --
+        // costs PCIe bandwidth on every cache admission for whatever lands
+        // here instead (no pinning => slower async copies), same tradeoff
+        // the fork's own alloc_buffer makes on cudaMallocHost failure.
+        return ggml_backend_buft_alloc_buffer(ggml_backend_cpu_buffer_type(), size);
+    }
+
+    ggml_backend_buffer_t buffer = ggml_backend_cpu_buffer_from_ptr(ptr, size);
+    buffer->buft = buft;
+    buffer->iface.free_buffer = moe_cached_buffer_free_buffer;
+    return buffer;
+}
+
+size_t moe_cached_buffer_type_get_max_size(ggml_backend_buffer_type_t buft) {
+    GGML_UNUSED(buft);
+    return k_moe_cache_max_alloc_bytes;
+}
+
+bool moe_cached_buffer_type_is_host(ggml_backend_buffer_type_t buft) {
+    // Must stay false -- see the module comment above (point 2).
+    GGML_UNUSED(buft);
+    return false;
+}
+
+} // namespace
+
+ggml_backend_buffer_type_t ggml_backend_sycl_moe_cached_buffer_type(void) {
+    static struct ggml_backend_buffer_type buft = {
+        /* .iface    = */ {
+            /* .get_name         = */ moe_cached_buffer_type_name,
+            /* .alloc_buffer     = */ moe_cached_buffer_type_alloc_buffer,
+            /* .get_alignment    = */ ggml_backend_cpu_buffer_type()->iface.get_alignment,
+            /* .get_max_size     = */ moe_cached_buffer_type_get_max_size,
+            /* .get_alloc_size   = */ ggml_backend_cpu_buffer_type()->iface.get_alloc_size,
+            /* .is_host          = */ moe_cached_buffer_type_is_host,
+        },
+        /* .device   = */ ggml_backend_reg_dev_get(ggml_backend_sycl_reg(), 0),
+        /* .context  = */ nullptr,
+    };
+    return &buft;
+}
+
+bool ggml_backend_buft_is_sycl_moe_cached(ggml_backend_buffer_type_t buft) {
+    return buft != nullptr && buft->iface.get_name == moe_cached_buffer_type_name;
+}
+
+ggml_backend_buffer_type_t * ggml_backend_sycl_moe_cached_get_extra_bufts(ggml_backend_dev_t dev) {
+    GGML_UNUSED(dev);
+    static ggml_backend_buffer_type_t bufts[] = { ggml_backend_sycl_moe_cached_buffer_type(), nullptr };
+    return bufts;
+}
+
+// ---------------------------------------------------------------------------
+// Phase 3a: legacy dispatch hook support -- per-tensor device slot cache,
+// plain LRU. See moe-cache.hpp for the design rationale (one cache per
+// cached expert tensor, single mutex, synchronous barrier for now).
+// ---------------------------------------------------------------------------
+
+struct sycl_moe_cache {
+    void * pool = nullptr;      // sycl::malloc_device, n_slots * slot_stride bytes
+    size_t slot_stride = 0;
+    int    n_slots = 0;
+
+    std::vector<int32_t>  slot_expert;    // -1 = empty slot
+    std::vector<uint64_t> slot_last_used;
+    std::unordered_map<int32_t, int32_t> expert_to_slot;
+    uint64_t clock = 0;
+
+    sycl::queue copy_queue; // separate queue, SAME context+device as compute -- see .hpp
+    std::mutex  mu;
+
+    // Marks "everything the compute queue had enqueued as of the end of
+    // this cache's last op is done" -- the copy queue must wait on this
+    // before overwriting any slot (see ggml_sycl_moe_cache_wait_for_prior_reads
+    // in moe-cache.hpp for why). Starts invalid; the first op's evictions
+    // (if any) have nothing to wait for since nothing has read from this
+    // cache's pool yet.
+    sycl::event last_compute_event;
+    bool        has_last_compute_event = false;
+
+    // --- Phase 3d: device-planned admission state ------------------------
+    // See moe-cache.hpp's Phase 3d section for the design. Everything below
+    // is device-resident and touched ONLY by the plan/gather kernels in
+    // ggml_sycl_moe_cache_plan_and_gather -- no host-side mirror is kept, so
+    // there's nothing here for the Phase 3a legacy path above to conflict
+    // with (that path keeps its own host-side slot_expert/expert_to_slot).
+    int    n_experts        = 0;        // n_as for this tensor
+    void * slot_table       = nullptr;  // device int32[n_experts]: slot or -1
+    void * expert_for_slot  = nullptr;  // device int32[n_slots]: expert or -1 (reverse map)
+    void * expert_frequency = nullptr;  // device uint32[n_experts]: raw hit count
+    void * expert_epoch     = nullptr;  // device uint32[n_experts]: step at last touch
+    void * device_step      = nullptr;  // device uint32 scalar: global call counter
+
+    // Per-call plan scratch (device-only), grown but never shrunk -- sized
+    // to n_ids_per_group, a per-model constant in practice (this model: 10),
+    // so growth happens at most once.
+    void * plan_remapped_ids = nullptr; // device int32[capacity]: slot per route
+    void * plan_miss_expert  = nullptr; // device int32[capacity]: expert id per miss
+    void * plan_miss_slot    = nullptr; // device int32[capacity]: assigned slot per miss
+    void * plan_n_misses     = nullptr; // device int32 scalar
+    int    plan_capacity     = 0;
+
+    sycl_moe_cache(sycl::queue compute_q, size_t stride, int slots, int n_as)
+        : slot_stride(stride), n_slots(slots),
+          slot_expert(slots, -1), slot_last_used(slots, 0),
+          copy_queue(compute_q.get_context(), compute_q.get_device()),
+          n_experts(n_as) {
+        pool             = sycl::malloc_device(stride * (size_t) slots, compute_q);
+        slot_table       = sycl::malloc_device(n_as * sizeof(int32_t), compute_q);
+        expert_for_slot  = sycl::malloc_device(slots * sizeof(int32_t), compute_q);
+        expert_frequency = sycl::malloc_device(n_as * sizeof(uint32_t), compute_q);
+        expert_epoch     = sycl::malloc_device(n_as * sizeof(uint32_t), compute_q);
+        device_step      = sycl::malloc_device(sizeof(uint32_t), compute_q);
+        plan_n_misses    = sycl::malloc_device(sizeof(int32_t), compute_q);
+        compute_q.fill<int32_t>((int32_t *) slot_table, -1, n_as);
+        compute_q.fill<int32_t>((int32_t *) expert_for_slot, -1, slots);
+        compute_q.fill<uint32_t>((uint32_t *) expert_frequency, 0, n_as);
+        compute_q.fill<uint32_t>((uint32_t *) expert_epoch, 0, n_as);
+        compute_q.fill<uint32_t>((uint32_t *) device_step, 0, 1);
+        compute_q.fill<int32_t>((int32_t *) plan_n_misses, 0, 1).wait();
+    }
+
+    ~sycl_moe_cache() {
+        if (pool != nullptr) {
+            sycl::free(pool, copy_queue);
+        }
+        if (slot_table != nullptr) {
+            sycl::free(slot_table, copy_queue);
+        }
+        if (expert_for_slot != nullptr) {
+            sycl::free(expert_for_slot, copy_queue);
+        }
+        if (expert_frequency != nullptr) {
+            sycl::free(expert_frequency, copy_queue);
+        }
+        if (expert_epoch != nullptr) {
+            sycl::free(expert_epoch, copy_queue);
+        }
+        if (device_step != nullptr) {
+            sycl::free(device_step, copy_queue);
+        }
+        if (plan_remapped_ids != nullptr) {
+            sycl::free(plan_remapped_ids, copy_queue);
+        }
+        if (plan_miss_expert != nullptr) {
+            sycl::free(plan_miss_expert, copy_queue);
+        }
+        if (plan_miss_slot != nullptr) {
+            sycl::free(plan_miss_slot, copy_queue);
+        }
+        if (plan_n_misses != nullptr) {
+            sycl::free(plan_n_misses, copy_queue);
+        }
+    }
+};
