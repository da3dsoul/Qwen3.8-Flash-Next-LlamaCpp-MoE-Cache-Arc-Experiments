diff --git a/ggml/src/ggml-sycl/fattn-sparse.cpp b/ggml/src/ggml-sycl/fattn-sparse.cpp
new file mode 100644
index 000000000..d4f16479e
--- /dev/null
+++ b/ggml/src/ggml-sycl/fattn-sparse.cpp
@@ -0,0 +1,350 @@
+//
+// MIT license
+// Copyright (C) 2025 Intel Corporation
+// SPDX-License-Identifier: MIT
+//
+
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+
+#include "fattn-sparse.hpp"
+#include "fattn-common.hpp"
+#include "convert.hpp"
+
+#include <algorithm>
+#include <cstring>
+#include <vector>
+
+// mask columns per work group, and work items per work group
+#define SPARSE_TILE 1024
+#define SPARSE_WG    256
+#define SPARSE_PER_ITEM (SPARSE_TILE/SPARSE_WG)
+
+// a column is kept when the mask does not mask it out. NaN is kept on purpose: dense would
+// propagate it, so dropping it would hide a bad mask instead of reproducing it.
+static inline bool fattn_sparse_keep(const sycl::half v) {
+    return !sycl::isinf((float) v);
+}
+
+static void fattn_sparse_count_tiles(const sycl::half * __restrict__ mask, int32_t * __restrict__ tile_cnt,
+                                     const int64_t n_kv, const int64_t n_tiles, const int64_t s33,
+                                     const sycl::nd_item<3> & it) {
+    const int64_t s   = it.get_group(1);
+    const int64_t t   = it.get_group(2);
+    const int     tid = it.get_local_id(2);
+
+    const sycl::half * row = mask + s*s33;
+
+    int c = 0;
+    for (int k = 0; k < SPARSE_PER_ITEM; ++k) {
+        const int64_t col = t*SPARSE_TILE + (int64_t) tid*SPARSE_PER_ITEM + k;
+        if (col < n_kv && fattn_sparse_keep(row[col])) {
+            c++;
+        }
+    }
+
+    c = sycl::reduce_over_group(it.get_group(), c, sycl::plus<int>());
+
+    if (tid == 0) {
+        tile_cnt[s*n_tiles + t] = c;
+    }
+}
+
+static void fattn_sparse_write_idx(const sycl::half * __restrict__ mask, const int32_t * __restrict__ tile_cnt,
+                                   int32_t * __restrict__ idx, int32_t * __restrict__ cnt,
+                                   const int64_t n_kv, const int64_t n_tiles, const int64_t n_rows,
+                                   const int64_t s33, const sycl::nd_item<3> & it) {
+    const int64_t s   = it.get_group(1);
+    const int64_t t   = it.get_group(2);
+    const int     tid = it.get_local_id(2);
+
+    const sycl::half * row = mask + s*s33;
+
+    // where this tile's columns start in the compact list
+    int off = 0;
+    for (int64_t i = tid; i < t; i += SPARSE_WG) {
+        off += tile_cnt[s*n_tiles + i];
+    }
+    off = sycl::reduce_over_group(it.get_group(), off, sycl::plus<int>());
+
+    bool    sel [SPARSE_PER_ITEM];
+    int64_t cols[SPARSE_PER_ITEM];
+
+    int local = 0;
+    for (int k = 0; k < SPARSE_PER_ITEM; ++k) {
+        const int64_t col = t*SPARSE_TILE + (int64_t) tid*SPARSE_PER_ITEM + k;
+        cols[k] = col;
+        sel [k] = col < n_kv && fattn_sparse_keep(row[col]);
+        local  += sel[k] ? 1 : 0;
+    }
+
+    const int base = sycl::exclusive_scan_over_group(it.get_group(), local, sycl::plus<int>());
+
+    int p = off + base;
+    for (int k = 0; k < SPARSE_PER_ITEM; ++k) {
+        if (sel[k]) {
+            // a mask row with more finite entries than n_kv_max breaks the op contract. clamp
+            // rather than write out of bounds; the debug check below reports it.
+            if (p < n_rows) {
+                idx[s*n_rows + p] = (int32_t) cols[k];
+            }
+            p++;
+        }
+    }
+
+    const int total = sycl::reduce_over_group(it.get_group(), local, sycl::plus<int>());
+    if (t == n_tiles - 1 && tid == 0) {
+        cnt[s] = off + total;
+    }
+}
+
+// rows are contiguous in both source and destination, so this copies bytes and stays type agnostic
+static void fattn_sparse_gather_rows(const char * __restrict__ src, char * __restrict__ dst,
+                                     const int32_t * __restrict__ idx, const int32_t * __restrict__ cnt,
+                                     const int64_t row_words, const int64_t n_rows, const int64_t nh,
+                                     const int64_t total, const size_t nb1, const size_t nb2, const size_t nb3,
+                                     const sycl::nd_item<1> & it) {
+    const int64_t g = it.get_global_linear_id();
+    if (g >= total) {
+        return;
+    }
+
+    const int64_t w = g % row_words;
+    const int64_t i = (g / row_words) % n_rows;
+    const int64_t h = (g / (row_words*n_rows)) % nh;
+    const int64_t s =  g / (row_words*n_rows*nh);
+
+    uint32_t v = 0;
+    if (i < cnt[s]) {
+        const int64_t r = idx[s*n_rows + i];
+        v = *(const uint32_t *) (src + s*nb3 + h*nb2 + r*nb1 + w*4);
+    }
+
+    *(uint32_t *) (dst + (((s*nh + h)*n_rows + i)*row_words + w)*4) = v;
+}
+
+static void fattn_sparse_gather_mask(const sycl::half * __restrict__ mask, sycl::half * __restrict__ dst,
+                                     const int32_t * __restrict__ idx, const int32_t * __restrict__ cnt,
+                                     const int64_t n_rows, const int64_t ne31, const int64_t ne01,
+                                     const int64_t total, const int64_t s31, const int64_t s33,
+                                     const sycl::nd_item<1> & it) {
+    const int64_t g = it.get_global_linear_id();
+    if (g >= total) {
+        return;
+    }
+
+    const int64_t i = g % n_rows;
+    const int64_t j = (g / n_rows) % ne31;
+    const int64_t s =  g / (n_rows*ne31);
+
+    sycl::half v = sycl::half(-INFINITY);
+    if (j < ne01 && i < cnt[s]) {
+        v = mask[s*s33 + j*s31 + idx[s*n_rows + i]];
+    }
+
+    dst[(s*ne31 + j)*n_rows + i] = v;
+}
+
+int64_t ggml_sycl_fattn_sparse_rows(const ggml_tensor * dst) {
+    if (dst->op != GGML_OP_FLASH_ATTN_EXT) {
+        return 0;
+    }
+
+    static const int enabled = ggml_sycl_get_env("GGML_SYCL_FA_SPARSE", 1);
+    if (enabled == 0) {
+        return 0;
+    }
+
+    const int32_t n_kv_max = ggml_get_op_params_i32(dst, 4);
+    if (n_kv_max <= 0) {
+        return 0;
+    }
+
+    const ggml_tensor * Q     = dst->src[0];
+    const ggml_tensor * K     = dst->src[1];
+    const ggml_tensor * V     = dst->src[2];
+    const ggml_tensor * mask  = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+
+    // one compact K/V copy serves one column set, which is what a single query row gives.
+    // prefill needs a set per query group and is a different design.
+    if (Q->ne[1] != 1 || !mask || sinks) {
+        return 0;
+    }
+
+    if (mask->type != GGML_TYPE_F16 || mask->ne[0] != K->ne[1] || mask->ne[2] != 1) {
+        return 0;
+    }
+
+    if (Q->ne[3] != mask->ne[3] || K->ne[3] != mask->ne[3] || V->ne[3] != mask->ne[3]) {
+        return 0;
+    }
+
+    float max_bias      = 0.0f;
+    float logit_softcap = 0.0f;
+    memcpy(&max_bias,      (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+
+    if (max_bias != 0.0f || logit_softcap != 0.0f) {
+        return 0;
+    }
+
+    for (const ggml_tensor * t : {K, V}) {
+        if (t->nb[0] != ggml_type_size(t->type) || t->ne[0] % ggml_blck_size(t->type) != 0) {
+            return 0;
+        }
+        if ((t->ne[0]/ggml_blck_size(t->type)*ggml_type_size(t->type)) % sizeof(uint32_t) != 0) {
+            return 0;
+        }
+    }
+
+    const int64_t n_rows = GGML_PAD((int64_t) n_kv_max, FATTN_KQ_STRIDE);
+
+    // the gather and the mask scan only pay off well below the dense depth. same bound as the
+    // CUDA path uses (ggml-cuda/fattn.cu).
+    if (K->ne[1] < std::max<int64_t>(4096, 2*n_rows)) {
+        return 0;
+    }
+
+    return n_rows;
+}
+
+void ggml_sycl_fattn_sparse_gather(ggml_backend_sycl_context & ctx, const ggml_tensor * dst, const int64_t n_rows,
+                                   const bool need_f16_K, const bool need_f16_V, const bool V_is_K_view,
+                                   ggml_sycl_fattn_sparse_ctx & sp) {
+    const ggml_tensor * Q    = dst->src[0];
+    const ggml_tensor * K    = dst->src[1];
+    const ggml_tensor * V    = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+
+    dpct::queue_ptr stream = ctx.stream();
+
+    const int64_t n_kv    = K->ne[1];
+    const int64_t nh      = K->ne[2];
+    const int64_t ns      = mask->ne[3];
+    const int64_t n_tiles = (n_kv + SPARSE_TILE - 1) / SPARSE_TILE;
+
+    const int64_t s31 = mask->nb[1] / sizeof(sycl::half);
+    const int64_t s33 = mask->nb[3] / sizeof(sycl::half);
+
+    const sycl::half * mask_src = (const sycl::half *) mask->data;
+
+    sp.idx     .alloc(n_rows*ns);
+    sp.cnt     .alloc(ns);
+    sp.tile_cnt.alloc(n_tiles*ns);
+
+    {
+        const sycl::range<3> grid(1, ns, n_tiles);
+        const sycl::range<3> wg  (1,  1, SPARSE_WG);
+
+        int32_t * tile_cnt = sp.tile_cnt.get();
+
+        stream->parallel_for(sycl::nd_range<3>(grid*wg, wg), [=](sycl::nd_item<3> it) {
+            fattn_sparse_count_tiles(mask_src, tile_cnt, n_kv, n_tiles, s33, it);
+        });
+
+        int32_t * idx      = sp.idx.get();
+        int32_t * cnt      = sp.cnt.get();
+        const int32_t * tc = tile_cnt;
+
+        stream->parallel_for(sycl::nd_range<3>(grid*wg, wg), [=](sycl::nd_item<3> it) {
+            fattn_sparse_write_idx(mask_src, tc, idx, cnt, n_kv, n_tiles, n_rows, s33, it);
+        });
+    }
+
+    const int32_t * idx = sp.idx.get();
+    const int32_t * cnt = sp.cnt.get();
+
+    // gather the selected rows in the cache's own type, then let the existing converter do the
+    // dequantization on a buffer that is n_rows tall instead of n_kv tall
+    auto gather = [&](const ggml_tensor * t, ggml_sycl_pool_alloc<char> & q_buf,
+                      ggml_sycl_pool_alloc<sycl::half> & f16_buf, const bool need_f16,
+                      const char ** data, size_t * nb1, size_t * nb2, size_t * nb3) {
+        const int64_t row_bytes = t->ne[0]/ggml_blck_size(t->type)*ggml_type_size(t->type);
+        const int64_t row_words = row_bytes/sizeof(uint32_t);
+        const int64_t total     = row_words*n_rows*nh*ns;
+
+        char * q_dst = q_buf.alloc(row_bytes*n_rows*nh*ns);
+
+        {
+            const size_t wg_size = 256;
+            const size_t global  = ((total + wg_size - 1)/wg_size)*wg_size;
+
+            const char * src = (const char *) t->data;
+            const size_t tb1 = t->nb[1];
+            const size_t tb2 = t->nb[2];
+            const size_t tb3 = t->nb[3];
+
+            stream->parallel_for(sycl::nd_range<1>(global, wg_size), [=](sycl::nd_item<1> it) {
+                fattn_sparse_gather_rows(src, q_dst, idx, cnt, row_words, n_rows, nh, total, tb1, tb2, tb3, it);
+            });
+        }
+
+        if (need_f16 && t->type != GGML_TYPE_F16) {
+            sycl::half * f16_dst = f16_buf.alloc(t->ne[0]*n_rows*nh*ns);
+
+            to_fp16_sycl_t to_fp16 = ggml_get_to_fp16_sycl(t->type, const_cast<ggml_tensor *>(dst));
+            to_fp16(q_dst, f16_dst, t->ne[0]*n_rows*nh*ns, stream);
+
+            *data = (const char *) f16_dst;
+            *nb1  = t->ne[0]*sizeof(sycl::half);
+        } else {
+            *data = q_dst;
+            *nb1  = row_bytes;
+        }
+
+        *nb2 = n_rows*(*nb1);
+        *nb3 = nh*(*nb2);
+    };
+
+    gather(K, sp.K_q, sp.K_f16, need_f16_K, &sp.K_data, &sp.nb11, &sp.nb12, &sp.nb13);
+
+    if (V_is_K_view) {
+        sp.V_data = sp.K_data;
+        sp.nb21   = sp.nb11;
+        sp.nb22   = sp.nb12;
+        sp.nb23   = sp.nb13;
+    } else {
+        gather(V, sp.V_q, sp.V_f16, need_f16_V, &sp.V_data, &sp.nb21, &sp.nb22, &sp.nb23);
+    }
+
+    {
+        const int64_t ne31  = mask->ne[1];
+        const int64_t ne01  = Q->ne[1];
+        const int64_t total = n_rows*ne31*ns;
+
+        sycl::half * mask_dst = sp.mask_f16.alloc(total);
+
+        const size_t wg_size = 256;
+        const size_t global  = ((total + wg_size - 1)/wg_size)*wg_size;
+
+        stream->parallel_for(sycl::nd_range<1>(global, wg_size), [=](sycl::nd_item<1> it) {
+            fattn_sparse_gather_mask(mask_src, mask_dst, idx, cnt, n_rows, ne31, ne01, total, s31, s33, it);
+        });
+
+        sp.mask_data = (const char *) mask_dst;
+        sp.nb31      = n_rows*sizeof(sycl::half);
+        sp.nb32      = ne31*sp.nb31;
+        sp.nb33      = sp.nb32;
+    }
+
+    // GGML_SYCL_FA_SPARSE_CHECK=1: verify the op contract that n_kv_max bounds every mask row.
+    // Over the bound the gather silently drops columns, so this is worth a sync while validating.
+    static const int check = ggml_sycl_get_env("GGML_SYCL_FA_SPARSE_CHECK", 0);
+    if (check) {
+        std::vector<int32_t> host_cnt(ns);
+        stream->memcpy(host_cnt.data(), cnt, ns*sizeof(int32_t)).wait();
+
+        const int32_t n_kv_max = ggml_get_op_params_i32(dst, 4);
+        for (int64_t s = 0; s < ns; ++s) {
+            if (host_cnt[s] > n_kv_max) {
+                GGML_LOG_ERROR("%s: mask row of sequence %ld has %d finite entries, n_kv_max is %d\n",
+                        __func__, (long) s, host_cnt[s], n_kv_max);
+                GGML_ABORT("sparse flash attention: n_kv_max does not bound the mask");
+            }
+        }
+    }
+}
