+const char * qsa_ph_name[PH_COUNT] = {
+    "prep.alloc", "prep.group_cells", "prep.blk_enum", "prep.cell_loop", "prep.fingerprint",
+    "set.cpy_cell_blk", "set.cpy_blk_cells", "set.blk_pos", "set.bias", "set.pool_cpy", "set.upd",
+    "PREPARE total", "SET_INPUT total"
