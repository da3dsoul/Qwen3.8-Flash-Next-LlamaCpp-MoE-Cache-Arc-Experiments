+                     int64_t idx_dim = 128, int64_t n_idx_h = 4, int64_t r = 4,
+                     int64_t n_tps = 1, int64_t n_stream = 1, int width = 2051,
+                     bool pooled_cached = false, bool block_topk = false)
+        : type_k(type_k), n_kv(n_kv), n_embd(n_embd), idx_dim(idx_dim), n_idx_h(n_idx_h),
+          r(r), n_tps(n_tps), n_stream(n_stream), width(width), pooled_cached(pooled_cached),
+          block_topk(block_topk) {}
+
+    // the chain ends in a top_k, whose output order is unspecified
+    double max_err() override { return 0.0; }
+    bool run_whole_graph() override { return true; }
+
+    // eval_perf repeats only the LAST node to amortize, which would divide one chain
+    // run by thousands of extra top_k conts. A size over its 32 GiB target makes
+    // n_runs == 1, so us/run is one run of the whole chain.
+    size_t op_size(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return size_t(64) << 30;
+    }
