+    // index tensors must address real rows, and the mask ramp keeps cell values
+    // distinct so the trailing top_k has no ties to break arbitrarily
+    void initialize_tensors(ggml_context * ctx) override {
+        const int64_t n_blocks = (n_kv + r - 1)/r;
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->op != GGML_OP_NONE) {
+                continue;
+            }
+            if (t->type == GGML_TYPE_I32) {
+                const int64_t mod = std::string(t->name) == "cell_blk" ? n_blocks : n_kv;
+                std::vector<int32_t> data(ggml_nelements(t));
+                for (auto & v : data) { v = rand() % mod; }
+                ggml_backend_tensor_set(t, data.data(), 0, data.size()*sizeof(int32_t));
+            } else if (t->type == GGML_TYPE_F16 && std::string(t->name) == "kq_mask") {
+                std::vector<ggml_fp16_t> data(ggml_nelements(t));
+                for (int64_t row = 0; row < ggml_nrows(t); row++) {
+                    for (int64_t i = 0; i < n_kv; i++) {
+                        data[row*n_kv + i] = ggml_fp32_to_fp16((float) i);
+                    }
+                }
+                ggml_backend_tensor_set(t, data.data(), 0, data.size()*sizeof(ggml_fp16_t));
+            } else {
+                init_tensor_uniform(t, 0.0f, 0.5f);
+            }
+        }
+    }
