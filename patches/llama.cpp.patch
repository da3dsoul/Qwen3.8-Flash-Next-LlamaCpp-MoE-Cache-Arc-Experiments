+// The two hyper-connection matchers below walk a long chain of exact structure tests.
+// GGML_SYCL_HC_DEBUG=1 names the test that rejected a graph, without the whole-backend
+// output GGML_SYCL_DEBUG=1 produces.
+static bool ggml_sycl_hc_debug() {
+    static const bool on = getenv("GGML_SYCL_HC_DEBUG") && atoi(getenv("GGML_SYCL_HC_DEBUG")) != 0;
+    return on;
+}
+
+// GGML_SYCL_HC_FUSION=0 turns off just these two matchers, leaving every other fusion in
+// place. That is the A/B the throughput numbers come from: one binary against itself.
+static bool ggml_sycl_hc_fusion_enabled() {
+    static const bool on = !getenv("GGML_SYCL_HC_FUSION") || atoi(getenv("GGML_SYCL_HC_FUSION")) != 0;
+    return on;
+}
+
+#define GGML_SYCL_HC_LOG(...)                 \
+    do {                                      \
+        if (ggml_sycl_hc_debug()) {           \
+            fprintf(stderr, "[SYCL][HC] ");   \
+            fprintf(stderr, __VA_ARGS__);     \
+        }                                     \
+    } while (0)
+
+#define GGML_SYCL_HC_NO_FUSE                            \
+    do {                                                \
+        GGML_SYCL_HC_LOG("no fuse, %s:%d\n", __func__, __LINE__); \
+        return 0;                                       \
+    } while (0)
+
+// index of the next node that really launches something, skipping the view/reshape
+// bookkeeping nodes the dispatch loop ignores. -1 when there is none.
+static int ggml_sycl_next_compute_node(const ggml_cgraph * cgraph, int from) {
+    for (int k = from; k < cgraph->n_nodes; ++k) {
+        const ggml_tensor * n = cgraph->nodes[k];
+        if (ggml_sycl_is_view_or_noop(n) || (n->flags & GGML_TENSOR_FLAG_COMPUTE) == 0) {
+            continue;
+        }
+        return k;
+    }
+    return -1;
+}
+
+// true when a and b share any bytes. Used to refuse a fusion whose output landed on top
+// of one of its own inputs, where one work item would overwrite what another still reads.
+static bool ggml_sycl_tensors_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+    const char * ab = (const char *) a->data;
+    const char * bb = (const char *) b->data;
+    return ab < bb + ggml_nbytes(b) && bb < ab + ggml_nbytes(a);
+}
+
+// qwen4exp hyper-connections, mean of the hc residual streams:
+//   cont(stream 0) + (hc-1) x add(stream c) + scale -> one kernel.
+// The streams are [n_embd, nt] views of one [hc*n_embd, nt] tensor, so the chain carries
+// view nodes between the launches and cannot go through ggml_can_fuse().
+// Returns the number of following nodes to skip (0 = no fusion).
+static int ggml_sycl_hc_stream_mean_fused(ggml_backend_sycl_context & ctx, ggml_cgraph * cgraph, int node_idx) {
+    if (!g_ggml_sycl_enable_fusion || !ggml_sycl_hc_fusion_enabled()) {
+        return 0;
+    }
+
+    ggml_tensor * cont = cgraph->nodes[node_idx];
+    if (cont->op != GGML_OP_CONT || cont->type != GGML_TYPE_F32 || !ggml_is_contiguous(cont)) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+    if (cont->ne[2] != 1 || cont->ne[3] != 1) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+
+    const ggml_tensor * v0   = cont->src[0];
+    const ggml_tensor * root = v0->view_src;
+    if (root == nullptr || root->type != GGML_TYPE_F32 || !ggml_is_contiguous(root)) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+    if (root->ne[2] != 1 || root->ne[3] != 1) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+
+    const int64_t n_embd = cont->ne[0];
+    const int64_t nt     = cont->ne[1];
+    if (n_embd <= 0 || nt <= 0 || root->ne[1] != nt || root->ne[0] % n_embd != 0) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+    const int64_t hc = root->ne[0] / n_embd;
+    if (hc < 2) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+
+    // stream c is the [n_embd, nt] view of root starting at column c with a hc*n_embd row pitch
+    auto is_stream_view = [&](const ggml_tensor * v, int64_t c) {
+        return v != nullptr && v->view_src == root && v->type == GGML_TYPE_F32 &&
+               v->ne[0] == n_embd && v->ne[1] == nt && v->ne[2] == 1 && v->ne[3] == 1 &&
+               v->nb[0] == sizeof(float) && v->nb[1] == (size_t) hc * n_embd * sizeof(float) &&
+               (const char *) v->data == (const char *) root->data + c * n_embd * sizeof(float);
+    };
+    if (!is_stream_view(v0, 0)) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+
+    ggml_tensor * run     = cont;
+    int           run_idx = node_idx;
+    for (int64_t c = 1; c < hc; ++c) {
+        const int k = ggml_sycl_next_compute_node(cgraph, run_idx + 1);
+        if (k < 0 || !ggml_node_has_n_uses(cgraph, run_idx, 1)) {
+            GGML_SYCL_HC_NO_FUSE;
+        }
+        ggml_tensor * add = cgraph->nodes[k];
+        if (add->op != GGML_OP_ADD || add->type != GGML_TYPE_F32 || !ggml_is_contiguous(add) ||
+            add->src[0] != run || !is_stream_view(add->src[1], c)) {
+            GGML_SYCL_HC_NO_FUSE;
+        }
+        run     = add;
+        run_idx = k;
+    }
+
+    // the trailing scale is optional: fold it in when it is there, else keep 1.0
+    float scale    = 1.0f;
+    int   last_idx = run_idx;
+    const int k = ggml_sycl_next_compute_node(cgraph, run_idx + 1);
+    if (k >= 0 && ggml_node_has_n_uses(cgraph, run_idx, 1)) {
+        ggml_tensor * sc = cgraph->nodes[k];
+        float         p[2];
+        memcpy(p, sc->op_params, sizeof(p));
+        if (sc->op == GGML_OP_SCALE && sc->type == GGML_TYPE_F32 && sc->src[0] == run &&
+            ggml_is_contiguous(sc) && p[1] == 0.0f) {
+            scale    = p[0];
+            run      = sc;
+            last_idx = k;
+        }
+    }
+
+    if (ggml_sycl_tensors_overlap(run, root)) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+
+    GGML_SYCL_HC_LOG("stream_mean fused: n_embd=%ld hc=%ld nt=%ld scale=%f\n",
+                     (long) n_embd, (long) hc, (long) nt, (double) scale);
+    ggml_sycl_op_hc_stream_mean(ctx, root, run, n_embd, hc, scale);
+    return last_idx - node_idx;
+}
+
+// qwen4exp hyper-connections, scatter of one block output back over the hc streams:
+//   repeat + scale + sigmoid + scale + mul + add -> one kernel.
+// Node order comes from the graph walk: repeat is emitted before the inject chain.
+// Returns the number of following nodes to skip (0 = no fusion).
+static int ggml_sycl_hc_combine_fused(ggml_backend_sycl_context & ctx, ggml_cgraph * cgraph, int node_idx) {
+    if (!g_ggml_sycl_enable_fusion || !ggml_sycl_hc_fusion_enabled()) {
+        return 0;
+    }
+
+    ggml_tensor * rep = cgraph->nodes[node_idx];
+    if (rep->op != GGML_OP_REPEAT || rep->type != GGML_TYPE_F32 || rep->ne[3] != 1) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+
+    const int64_t n_embd = rep->ne[0];
+    const int64_t hc     = rep->ne[1];
+    const int64_t nt     = rep->ne[2];
+    if (hc < 2) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+
+    const ggml_tensor * b = rep->src[0];
+    if (b->type != GGML_TYPE_F32 || b->nb[0] != sizeof(float) ||
+        b->ne[0] != n_embd || b->ne[1] != 1 || b->ne[2] != nt || b->ne[3] != 1) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+
+    int k = ggml_sycl_next_compute_node(cgraph, node_idx + 1);
+    if (k < 0 || !ggml_node_has_n_uses(cgraph, node_idx, 1)) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+    ggml_tensor * s1 = cgraph->nodes[k];
+    float         p1[2];
+    memcpy(p1, s1->op_params, sizeof(p1));
+    if (s1->op != GGML_OP_SCALE || s1->type != GGML_TYPE_F32 || p1[1] != 0.0f ||
+        s1->ne[0] != hc || s1->ne[1] != nt || s1->ne[2] != 1 || s1->ne[3] != 1) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+    const ggml_tensor * inject = s1->src[0];
+    if (inject->type != GGML_TYPE_F32 || inject->nb[0] != sizeof(float)) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+    const int s1_idx = k;
+
+    k = ggml_sycl_next_compute_node(cgraph, s1_idx + 1);
+    if (k < 0 || !ggml_node_has_n_uses(cgraph, s1_idx, 1)) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+    ggml_tensor * sig = cgraph->nodes[k];
+    if (sig->op != GGML_OP_UNARY || ggml_get_unary_op(sig) != GGML_UNARY_OP_SIGMOID ||
+        sig->src[0] != s1) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+    const int sig_idx = k;
+
+    k = ggml_sycl_next_compute_node(cgraph, sig_idx + 1);
+    if (k < 0 || !ggml_node_has_n_uses(cgraph, sig_idx, 1)) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+    ggml_tensor * s2 = cgraph->nodes[k];
+    float         p2[2];
+    memcpy(p2, s2->op_params, sizeof(p2));
+    if (s2->op != GGML_OP_SCALE || s2->type != GGML_TYPE_F32 || p2[1] != 0.0f || s2->src[0] != sig) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+    const int s2_idx = k;
+
+    k = ggml_sycl_next_compute_node(cgraph, s2_idx + 1);
+    if (k < 0 || !ggml_node_has_n_uses(cgraph, s2_idx, 1)) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+    ggml_tensor * mul = cgraph->nodes[k];
+    if (mul->op != GGML_OP_MUL || mul->type != GGML_TYPE_F32 || mul->src[0] != rep) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+    // the weight side is the [1, hc, nt] reshape of the second scale
+    const ggml_tensor * w = mul->src[1];
+    if (w == nullptr || w->view_src != s2 || w->ne[0] != 1 || w->ne[1] != hc ||
+        w->ne[2] != nt || w->ne[3] != 1) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+    const int mul_idx = k;
+
+    k = ggml_sycl_next_compute_node(cgraph, mul_idx + 1);
+    if (k < 0 || !ggml_node_has_n_uses(cgraph, mul_idx, 1)) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+    ggml_tensor * add = cgraph->nodes[k];
+    if (add->op != GGML_OP_ADD || add->type != GGML_TYPE_F32 || add->src[1] != mul) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+    const ggml_tensor * residual = add->src[0];
+    if (residual->type != GGML_TYPE_F32 || residual->nb[0] != sizeof(float) ||
+        !ggml_are_same_shape(residual, add) || !ggml_are_same_shape(add, rep)) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+    if (add->nb[0] != sizeof(float)) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+
+    // ggml-alloc often writes the add in place over the residual. That is fine: every work
+    // item stores the element it just read. Any other overlap is a real race, so refuse it.
+    const bool res_inplace = add->data == residual->data && ggml_are_same_stride(add, residual);
+    if ((!res_inplace && ggml_sycl_tensors_overlap(add, residual)) ||
+        ggml_sycl_tensors_overlap(add, b) || ggml_sycl_tensors_overlap(add, inject)) {
+        GGML_SYCL_HC_NO_FUSE;
+    }
+
+    GGML_SYCL_HC_LOG("combine fused: n_embd=%ld hc=%ld nt=%ld inv=%f gain=%f\n",
+                     (long) n_embd, (long) hc, (long) nt, (double) p1[0], (double) p2[0]);
+    ggml_sycl_op_hc_combine(ctx, residual, b, inject, add, p1[0], p2[0]);
+    return k - node_idx;
+}
