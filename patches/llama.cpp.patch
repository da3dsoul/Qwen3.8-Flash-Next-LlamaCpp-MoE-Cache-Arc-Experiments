+        expanded = ggml_add(ctx, expanded, ggml_reshape_3d(ctx, mask, n_kv, n_tps, n_stream));
+
+        out = ggml_cont(ctx, ggml_top_k(ctx, expanded, width));
+        ggml_set_name(out, "out");
+        return out;
+    }
