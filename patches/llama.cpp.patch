+        ggml_set_name(wq, "index_q_proj");
+        ggml_tensor * k_all = ggml_new_tensor_3d(ctx, type_k, idx_dim, n_kv, n_stream);
+        ggml_set_name(k_all, "k_all");
+        ggml_tensor * blk_cells = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, r*n_blocks, n_stream);
+        ggml_set_name(blk_cells, "blk_cells");
+        ggml_tensor * blk_pos = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 4*n_blocks*n_stream);
+        ggml_set_name(blk_pos, "blk_pos");
+        ggml_tensor * inp_pos = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 4*n_tokens);
+        ggml_set_name(inp_pos, "inp_pos");
+        ggml_tensor * cell_blk = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_kv, n_stream);
+        ggml_set_name(cell_blk, "cell_blk");
+        ggml_tensor * bias = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, n_blocks, n_tps, n_stream);
+        ggml_set_name(bias, "bias");
+        ggml_tensor * kq_mask = ggml_new_tensor_3d(ctx, GGML_TYPE_F16, n_kv, n_tps, n_stream);
+        ggml_set_name(kq_mask, "kq_mask");
