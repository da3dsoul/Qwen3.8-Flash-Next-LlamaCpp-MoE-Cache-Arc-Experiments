@@ -276,6 +276,23 @@ static best_fattn_kernel ggml_sycl_get_best_fattn_kernel(const int device, const
 void ggml_sycl_flash_attn_ext(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
     ggml_sycl_set_device(ctx.device);
 
+    // Timing-only diagnostic (GGML_SYCL_FA_SKIP=1): enqueue no attention work
+    // at all and leave dst as-is.
+    //
+    // WARNING -- the obvious use of this knob is WRONG on a MoE model. Garbage
+    // attention output degenerates the router, so the same experts get picked
+    // every token and an expert cache stops missing. Measured on
+    // Qwen3.8-Flash-Next: skipping FA moved the MoE cache from 68% to 99% hit
+    // (3.17 -> 0.06 misses per 10 routes) and its gather from 12.1 to 1.3
+    // ms/token, which alone accounted for the whole 8.3 -> 23.5 t/s "speedup".
