+// escape hatch for an A/B of the pooled-key cache below
+static bool qsa_pool_off() {
+    static const bool res = getenv("LLAMA_QSA_NO_POOL_CACHE") != nullptr;
+
+    return res;
+}
+
+// The pooled block keys are a function of the cells and their positions only, so they are kept
+// here instead of being re-derived from the whole cache on every token. One F32 buffer per QSA
+// layer, indexed by block id, written by the graph through cpy_qsa_pool.
+void llama_memory_hybrid_idx::init_qsa_pool(const llama_model & model, uint32_t kv_size, bool offload, const layer_filter_cb & filter_idx) {
+    const auto & hparams = model.hparams;
+
+    const int64_t idx_dim = hparams.indexer_head_size;
+
+    if (idx_dim == 0 || qsa_pool_off()) {
+        return;
+    }
+
+    // one shared block layout, so one fingerprint. two ratios would need one each
+    for (uint32_t il = 0; il < hparams.n_layer_all; ++il) {
+        if (!filter_idx(il) || hparams.dsv4_compress_ratios[il] == 0) {
+            continue;
+        }
+
+        if (qsa_pool_ratio != 0 && qsa_pool_ratio != hparams.dsv4_compress_ratios[il]) {
+            LLAMA_LOG_INFO("%s: mixed compress ratios, the QSA pooled-key cache stays off\n", __func__);
+            qsa_pool_ratio = 0;
+
+            return;
+        }
+
+        qsa_pool_ratio = hparams.dsv4_compress_ratios[il];
+    }
+
+    if (qsa_pool_ratio == 0) {
+        return;
+    }
+
+    struct ggml_backend_buft_comparator {
+        bool operator()(const ggml_backend_buffer_type_t & lhs, const ggml_backend_buffer_type_t & rhs) const {
+            return strcmp(ggml_backend_buft_name(lhs), ggml_backend_buft_name(rhs)) < 0;
+        }
+    };
+
+    std::map<ggml_backend_buffer_type_t, ggml_context_ptr, ggml_backend_buft_comparator> ctx_map;
+
+    const uint32_t n_layer = hparams.n_layer_all;
+
+    auto ctx_for_buft = [&](ggml_backend_buffer_type_t buft) -> ggml_context * {
+        auto it = ctx_map.find(buft);
+        if (it == ctx_map.end()) {
+            ggml_init_params params = {
+                /*.mem_size   =*/ size_t(n_layer*ggml_tensor_overhead()),
+                /*.mem_buffer =*/ NULL,
+                /*.no_alloc   =*/ true,
+            };
+
+            ggml_context * ctx = ggml_init(params);
+            if (!ctx) {
+                return nullptr;
+            }
+
+            ctx_map.emplace(buft, ctx);
+
+            return ctx;
+        }
+
+        return it->second.get();
+    };
+
+    const int64_t n_blocks = (kv_size + qsa_pool_ratio - 1)/qsa_pool_ratio;
+
+    for (uint32_t il = 0; il < n_layer; ++il) {
+        if (!filter_idx(il) || hparams.dsv4_compress_ratios[il] == 0) {
+            continue;
+        }
+
+        ggml_backend_buffer_type_t buft = ggml_backend_cpu_buffer_type();
+
+        if (offload) {
+            buft = ggml_backend_dev_buffer_type(model.dev_layer(il));
+        }
+
+        ggml_context * ctx = ctx_for_buft(buft);
+        if (!ctx) {
+            throw std::runtime_error("failed to create ggml context for the QSA pooled-key cache");
+        }
+
+        ggml_tensor * t = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, idx_dim, n_blocks);
+        ggml_format_name(t, "cache_qsa_pool_l%d", il);
+
+        qsa_pool[il] = t;
+    }
+
+    for (auto & [buft, ctx] : ctx_map) {
+        ggml_backend_buffer_t buf;
+
+        if (hparams.no_alloc) {
+            buf = ggml_backend_buft_alloc_buffer(buft, /*size =*/ 0);
+            for (ggml_tensor * t = ggml_get_first_tensor(ctx.get()); t != nullptr; t = ggml_get_next_tensor(ctx.get(), t)) {
+                t->buffer = buf;
+            }
+        } else {
+            buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), buft);
+        }
+
+        if (!buf) {
+            throw std::runtime_error("failed to allocate buffer for the QSA pooled-key cache");
+        }
+
+        LLAMA_LOG_INFO("%s: %10s QSA pooled-key buffer size = %8.2f MiB\n", __func__,
+                ggml_backend_buffer_name(buf), ggml_backend_buffer_get_size(buf)/1024.0/1024.0);
+
+        // the blocks past the last one in use are masked out, but they must not be a nan
+        ggml_backend_buffer_clear(buf, 0);
+
+        qsa_pool_ctxs_bufs.emplace_back(std::move(ctx), buf);
+    }
+}
+
+bool llama_memory_hybrid_idx::has_qsa_pool(uint32_t ratio) const {
+    return qsa_pool_ratio != 0 && qsa_pool_ratio == ratio;
+}
+
+ggml_tensor * llama_memory_hybrid_idx::cpy_qsa_pool(ggml_context * ctx, ggml_tensor * pool_cur, ggml_tensor * blk_idxs, int32_t il) const {
+    const auto it = qsa_pool.find(il);
+    GGML_ASSERT(it != qsa_pool.end());
+
+    return ggml_set_rows(ctx, it->second, pool_cur, blk_idxs);
+}
