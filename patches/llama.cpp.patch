+// ---------------------------------------------------------------------------
+// Diagnostic stage profiler (GGML_SYCL_MOE_PROFILE=1), OFF by default.
+//
+// The standalone benchmark can only measure what it models. It said the
+// plan+gather kernels cost ~0.30 ms (gate/up) and ~0.38 ms (down) per op at
+// Flash-Next's real dimensions, i.e. ~47 ms/token across 144 ops -- but the
+// real run takes 244 ms/token. Something outside the benchmark's model owns
+// the other ~200 ms, and guessing which stage is exactly the mistake this
+// project already made three times. This attributes it directly, on the real
+// model, by draining the queue between stages and timing each on the host.
+//
+// The draining makes the run SLOWER than production, so absolute t/s under
+// this flag is meaningless -- the per-stage SPLIT is the output. Never enable
+// it for a benchmark run.
+namespace {
+
+struct moe_profile_state {
+    uint64_t n_calls   = 0;
+    double   plan_ms   = 0.0;
+    double   gather_ms = 0.0;
+    double   gemv_ms   = 0.0;
+    double   other_ms  = 0.0;   // graph time outside the cached-MoE ops
+    uint64_t misses    = 0;
+    uint64_t routes    = 0;
+    uint64_t declines  = 0;
+    std::chrono::steady_clock::time_point last_report;
+    bool     have_last = false;
+};
+
+moe_profile_state g_prof;
+
+double moe_prof_since(std::chrono::steady_clock::time_point t0) {
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+}
+
+} // namespace
+
+bool ggml_sycl_moe_cache_profile_enabled() {
+    static const bool enabled = getenv("GGML_SYCL_MOE_PROFILE") != nullptr;
+    return enabled;
+}
+
+void ggml_sycl_moe_cache_profile_first_call_marker(const char * where) {
+    static bool printed = false;
+    if (!printed) {
+        printed = true;
+        fprintf(stderr, "MOE_PROFILE first entry: %s\n", where);
+    }
+}
+
+void ggml_sycl_moe_cache_profile_add_gemv(double ms) {
+    g_prof.gemv_ms += ms;
+}
+
+void ggml_sycl_moe_cache_profile_note_decline() {
+    g_prof.declines++;
+}
+
+// Called once per cached-MoE op, after that op's GEMV has been timed. Reports
+// every `ops_per_token` calls, i.e. roughly once per generated token.
+void ggml_sycl_moe_cache_profile_tick(int ops_per_token) {
+    if (ops_per_token <= 0) {
+        ops_per_token = 144;
+    }
+    if ((g_prof.n_calls % (uint64_t) ops_per_token) != 0 || g_prof.n_calls == 0) {
+        return;
+    }
+    const double n_tokens = (double) g_prof.n_calls / ops_per_token;
+    double wall_per_token = 0.0;
+    if (g_prof.have_last) {
+        wall_per_token = moe_prof_since(g_prof.last_report);
+    }
+    g_prof.last_report = std::chrono::steady_clock::now();
+    g_prof.have_last   = true;
+
+    // fprintf, not GGML_LOG_INFO: llama-cli suppresses info-level logging by
+    // default, which is why the first instrumented run printed nothing at all.
+    fprintf(stderr,
+                  "MOE_PROFILE ops=%llu (~%.0f tok) per-token: plan %.1f ms, gather %.1f ms, gemv %.1f ms | "
+                  "misses %.2f/%.2f routes (%.0f%% hit) | declines %llu | wall %.1f ms/tok\n",
+                  (unsigned long long) g_prof.n_calls, n_tokens,
+                  g_prof.plan_ms / n_tokens, g_prof.gather_ms / n_tokens, g_prof.gemv_ms / n_tokens,
+                  (double) g_prof.misses / g_prof.n_calls, (double) g_prof.routes / g_prof.n_calls,
+                  g_prof.routes ? 100.0 * (1.0 - (double) g_prof.misses / (double) g_prof.routes) : 0.0,
+                  (unsigned long long) g_prof.declines, wall_per_token);
+    GGML_UNUSED(g_prof.other_ms);
+}
+
+int ggml_sycl_moe_cache_debug_n_misses(sycl_moe_cache * cache, sycl::queue & q) {
+    // Standalone-benchmark only: how many unique misses the LAST plan kernel
+    // actually recorded. Achieved gather bandwidth is meaningless without it
+    // (assuming "every route missed" understates the real figure by whatever
+    // the hit rate happens to be, which is exactly the quantity under study
+    // when comparing a 96/256-resident model against a 96/512-resident one).
+    int32_t n = 0;
+    q.memcpy(&n, cache->plan_n_misses, sizeof(int32_t)).wait();
+    return (int) n;
+}
+
+int ggml_sycl_moe_cache_debug_last_events(sycl::event * out, int max_out) {
+    const int n = g_moe_last_event_count < max_out ? g_moe_last_event_count : max_out;
+    for (int i = 0; i < n; ++i) {
+        out[i] = g_moe_last_events[i];
+    }
+    return g_moe_last_event_count;
+}
+
+const int32_t * ggml_sycl_moe_cache_plan_and_gather(sycl_moe_cache * cache, const ggml_tensor * src0,
+                                                     sycl::queue & compute_q, const int32_t * ids_dev,
+                                                     int n_ids_per_group) {
+    {
+        std::lock_guard<std::mutex> lock(cache->mu);
+        if (n_ids_per_group > cache->plan_capacity) {
+            if (cache->plan_remapped_ids != nullptr) sycl::free(cache->plan_remapped_ids, compute_q);
+            if (cache->plan_miss_expert  != nullptr) sycl::free(cache->plan_miss_expert, compute_q);
+            if (cache->plan_miss_slot    != nullptr) sycl::free(cache->plan_miss_slot, compute_q);
+            cache->plan_remapped_ids = sycl::malloc_device(n_ids_per_group * sizeof(int32_t), compute_q);
+            cache->plan_miss_expert  = sycl::malloc_device(n_ids_per_group * sizeof(int32_t), compute_q);
+            cache->plan_miss_slot    = sycl::malloc_device(n_ids_per_group * sizeof(int32_t), compute_q);
+            cache->plan_capacity     = n_ids_per_group;
+        }
+    }
+
+    // Extract raw device pointers/scalars before the kernel submits below --
+    // the lambdas must not capture `cache` (a host object) or `src0` (ditto);
+    // see moe-cache.hpp's Phase 3d comment.
+    int32_t *  slot_table       = (int32_t *) cache->slot_table;
+    int32_t *  expert_for_slot  = (int32_t *) cache->expert_for_slot;
+    uint32_t * expert_frequency = (uint32_t *) cache->expert_frequency;
+    uint32_t * expert_epoch     = (uint32_t *) cache->expert_epoch;
+    uint32_t * device_step      = (uint32_t *) cache->device_step;
+    int32_t *  remapped_ids     = (int32_t *) cache->plan_remapped_ids;
+    int32_t *  miss_expert      = (int32_t *) cache->plan_miss_expert;
+    int32_t *  miss_slot        = (int32_t *) cache->plan_miss_slot;
+    int32_t *  n_misses_dev     = (int32_t *) cache->plan_n_misses;
+    const int  n_slots          = cache->n_slots;
+
+    // The PLANNING kernel is one work-group by design, matching the CUDA
+    // reference's moe_grouped_plan_decode<<<1, plan_threads>>> exactly: the
+    // eviction bookkeeping is inherently a single shared mutable table, so
+    // spreading it over multiple work-groups would need device-wide
+    // synchronization SYCL does not portably offer. Victim selection within
+    // that one work-group IS parallel (a work-group-wide min-reduction over
+    // slots, mirroring moe_grouped_warp_min, moe-cache.cu:2786-2830) -- an
+    // earlier single-work-item serial scan ate the full memory latency of
+    // every dependent slot read with nothing to hide it behind.
+    //
+    // The GATHER is emphatically NOT part of this kernel any more, and that
+    // is the entire performance fix -- see moe_submit_gather above. It runs
+    // as a second kernel enqueued right after this one on the same in-order
+    // queue, exactly as the CUDA reference launches its two kernels back to
+    // back on one stream, needing no synchronization beyond that ordering.
+    //
+    // The long-standing worry that a second launch is too expensive on this
+    // SYCL/Level-Zero stack was finally measured instead of assumed: a
+    // pipelined no-op kernel launch costs 3.0-4.0 us here, i.e. ~0.5 ms per
+    // token across all 144 MoE ops. The fused byte gather it was protecting
+    // cost 1478 ms per token. The trade was never close.
+    const char * cold_base = (const char *) src0->data;
+    char *       pool_base = (char *) cache->pool;
+    const size_t row_bytes = cache->slot_stride;
+    const int    wg_size          = k_moe_plan_wg_size;
+    const int    n_ids_capture    = n_ids_per_group; // captured by value below
+    const int    n_experts_capture = cache->n_experts;
+
+    sycl::event plan_event = compute_q.submit([=](sycl::handler & cgh) {
+        // A router id outside [0, n_experts) would be an out-of-bounds
+        // slot_table/expert_for_slot access (undefined behavior on-device),
+        // so every route's id is sanitized ONCE here (clamped to 0, always
+        // a valid expert index when n_experts >= 1) and every later phase
+        // uses this sanitized copy instead of re-reading ids_dev -- never
+        // partially, since a half-sanitized read/write split is worse than
+        // either doing it consistently or not at all.
+        sycl::local_accessor<int32_t,  1> local_safe_eid(n_ids_capture, cgh);
+        sycl::local_accessor<int32_t,  1> local_hit_slot(n_ids_capture, cgh);
+        sycl::local_accessor<int32_t,  1> local_route_owner(n_ids_capture, cgh);
+        sycl::local_accessor<int32_t,  1> local_unique_miss(n_ids_capture, cgh); // expert id, then repurposed to hold assigned slot
+        sycl::local_accessor<int32_t,  1> local_n_unique(1, cgh);
+        // Experts this SAME call already needs at a known-good slot (hit
+        // routes) -- must never be evicted by THIS call's own miss
+        // resolution below. Without this, resolving miss B could steal the
+        // slot hit route A already committed to reading, silently feeding
+        // the GEMV kernel expert B's weights for route A: found the hard
+        // way (garbled/degenerate greedy-decode output on real hardware,
+        // not caught by the earlier single-thread version's less thorough
+        // testing -- this bug predates the parallel reduction, it was just
+        // easier to trigger once the cache was actually under real load).
+        sycl::local_accessor<int32_t,  1> local_protected_expert(n_ids_capture, cgh);
+        sycl::local_accessor<int32_t,  1> local_n_protected(1, cgh);
+        // Work-group-local MIRROR of the admission tables the miss loop below
+        // scans and mutates. This is what lets that loop's barriers be
+        // local_space instead of global_and_local: an Intel GPU's global
+        // fence flushes/invalidates caches device-wide, and the loop paid two
+        // of them per unique miss. The mirror is tiny (n_slots is 96 in
+        // practice: 768 B of packed keys plus 384 B of occupants), the loop's
+        // reads and writes all land in it, and the ~10 global entries the
+        // call actually changes are written straight out by lid 0 -- nothing
+        // in the loop reads them back, so their visibility is guaranteed by
+        // kernel completion alone, which is exactly what the following gather
+        // kernel on the same in-order queue relies on anyway.
+        sycl::local_accessor<int32_t,  1> local_slot_expert(n_slots, cgh);
+        sycl::local_accessor<uint32_t, 1> local_slot_score(n_slots, cgh);
+        // Slots THIS call has already admitted into. Kept separate from the
+        // protected-expert list (which holds this call's cache HITS and is
+        // scanned per candidate) because it is a direct per-slot flag: no
+        // inner search, and no need to grow a shared count inside the loop.
+        sycl::local_accessor<int32_t,  1> local_slot_pinned(n_slots, cgh);
+
+        cgh.parallel_for(sycl::nd_range<1>(sycl::range<1>(wg_size), sycl::range<1>(wg_size)),
+            [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                const int lid = (int) item.get_local_id(0);
+
+                // Every work-item derives the same step; only lid 0 commits
+                // it. Reading it redundantly costs one broadcast load and
+                // saves an entire barrier, because the parallel mirror load
+                // below needs `step` for its decay computation and would
+                // otherwise have to wait for lid 0 to publish it.
+                const uint32_t step_now = *device_step + 1;
+                if (lid == 0) {
+                    *device_step = step_now;
+                }
+
+                // Parallel mirror load: one pass over the slot table, decay
+                // included, before anyone needs it. Independent of the serial
+                // route scan below, so both sit in front of the SAME barrier.
+                for (int s = lid; s < n_slots; s += wg_size) {
+                    const int32_t occ    = expert_for_slot[s];
+                    local_slot_expert[s] = occ;
+                    local_slot_pinned[s] = 0;
+                    local_slot_score[s]  = (occ < 0) ? 0u
+                        : moe_plan_effective_frequency(expert_frequency[occ], expert_epoch[occ], step_now);
+                }
+
+                // Phases A/A1/A2 merged into one lid==0 serial block with a
+                // SINGLE trailing barrier, instead of three barrier-
+                // separated phases (step-counter update, a parallel
+                // per-route hit-check, then a serial dedup pass). Measured
+                // directly: with the miss-resolution loop below not the
+                // bottleneck (three different reduction implementations all
+                // measured identically slow), the baseline barrier count
+                // PER CALL -- paid even when there are zero misses, i.e.
+                // most calls once the cache is warm -- was the remaining
+                // suspect. n_ids_per_group is tiny (~10), so parallelizing
+                // its hit-check across work-items was never worth a whole
+                // extra barrier; doing it serially alongside the dedup pass
+                // that already had to be serial removes it for free.
+                if (lid == 0) {
+                    int32_t n_unique    = 0;
+                    int32_t n_protected = 0;
+                    for (int r = 0; r < n_ids_capture; ++r) {
+                        const int32_t raw = ids_dev[r];
+                        const int32_t eid = (raw >= 0 && raw < n_experts_capture) ? raw : 0;
+                        local_safe_eid[r] = eid;
+                        const int32_t hit = slot_table[eid];
+                        local_hit_slot[r] = hit;
+
+                        if (hit >= 0) {
+                            bool already_protected = false;
+                            for (int p = 0; p < n_protected; ++p) {
+                                if (local_protected_expert[p] == eid) {
+                                    already_protected = true;
+                                    break;
+                                }
+                            }
+                            if (!already_protected) {
+                                local_protected_expert[n_protected++] = eid;
+                            }
+                            continue;
+                        }
+                        int32_t owner = -1;
+                        for (int rr = 0; rr < r; ++rr) {
+                            if (local_hit_slot[rr] < 0 && local_safe_eid[rr] == eid) {
+                                owner = local_route_owner[rr];
+                                break;
+                            }
+                        }
+                        if (owner < 0) {
+                            owner = n_unique;
+                            local_unique_miss[n_unique] = eid;
+                            n_unique++;
+                        }
+                        local_route_owner[r] = owner;
+                    }
+                    local_n_unique[0]    = n_unique;
+                    local_n_protected[0] = n_protected;
+                }
+                item.barrier(sycl::access::fence_space::local_space);
+                const uint32_t step           = step_now;
+                const int32_t  n_unique_misses = local_n_unique[0];
+                const int32_t  n_protected     = local_n_protected[0];
+
+                // Phase B: resolve each unique miss in turn. Victim
+                // selection is a genuine work-group-wide min-reduction
+                // (mirrors moe_grouped_warp_min in the CUDA reference, via
+                // sycl::reduce_over_group with a packed uint64_t key instead
+                // of a hand-rolled shuffle+barrier+combine -- see
+                // moe_plan_pack_candidate's comment); committing the
+                // winning slot's eviction is single-writer (lid 0) since it
+                // mutates the shared admission tables the NEXT iteration's
+                // scan reads -- hence the barrier at the end of the loop
+                // body. Those tables are now the work-group-LOCAL mirror
+                // loaded above, which is what makes that barrier a local
+                // fence rather than a device-wide one.
+                for (int32_t u = 0; u < n_unique_misses; ++u) {
+                    uint64_t local_best = moe_plan_pack_candidate(1u, 0xFFFFFFFFu, 0x0FFFFFFF);
+                    for (int s = lid; s < n_slots; s += wg_size) {
+                        const int32_t occ = local_slot_expert[s];
+
+                        bool is_protected = local_slot_pinned[s] != 0;
+                        if (occ >= 0 && !is_protected) {
+                            for (int p = 0; p < n_protected; ++p) {
+                                if (local_protected_expert[p] == occ) {
+                                    is_protected = true;
+                                    break;
+                                }
+                            }
+                        }
+                        // rank 0 = empty (best), 1 = ordinary occupied, 2 =
+                        // protected (this call's own hit, or an expert THIS
+                        // call already admitted) -- never chosen unless
+                        // literally every slot is protected, which shouldn't
+                        // happen given n_slots >> n_ids_per_group.
+                        const uint32_t rank  = is_protected ? 2u : ((occ < 0) ? 0u : 1u);
+                        const uint32_t score = is_protected ? 0u : local_slot_score[s];
+                        const uint64_t cand  = moe_plan_pack_candidate(rank, score, s);
+                        if (cand < local_best) {
+                            local_best = cand;
+                        }
+                    }
+
+                    const uint64_t best_key =
+                        sycl::reduce_over_group(item.get_group(), local_best, sycl::minimum<uint64_t>());
+
+                    if (lid == 0) {
+                        const int32_t best_slot  = moe_plan_unpack_slot(best_key);
+                        const int32_t eid        = local_unique_miss[u];
+                        const int32_t old_expert = local_slot_expert[best_slot];
+                        if (old_expert >= 0) {
+                            slot_table[old_expert] = -1;
+                        }
+                        expert_for_slot[best_slot] = eid;
+                        slot_table[eid]            = best_slot;
+                        expert_frequency[eid]      = 1;
+                        expert_epoch[eid]          = step;
+
+                        // Mirror the same commit locally, and mark the slot
+                        // rank-2 (protected) so a LATER miss in this same call
+                        // cannot evict an expert this call has already
+                        // admitted and is about to gather into. The previous
+                        // version left the fresh occupant at score 1, which
+                        // only avoided that by luck: it needed at least one
+                        // other slot to score 0, which is usual but not
+                        // guaranteed. Losing that race would have handed the
+                        // GEMV kernel the wrong expert's weights.
+                        local_slot_expert[best_slot] = eid;
+                        local_slot_score[best_slot]  = 0u;
+                        local_slot_pinned[best_slot] = 1;
+
+                        miss_expert[u] = eid;
+                        miss_slot[u]   = best_slot;
+                        local_unique_miss[u] = best_slot; // repurposed: route resolution (Phase C) reads this as a slot index
+                    }
+                    // The next iteration's scan reads local_slot_expert /
+                    // local_slot_score / local_protected_expert, all of which
+                    // lid 0 just wrote -- work-group-local memory only, so a
+                    // local fence is sufficient and a device-wide one is pure
+                    // cost. The global writes above are read by nobody until
+                    // this kernel completes.
+                    item.barrier(sycl::access::fence_space::local_space);
+                }
+
+                if (lid == 0) {
+                    *n_misses_dev = n_unique_misses;
+                }
+
+                // Phase C: write remapped_ids for every route (global, read
+                // by the GEMV kernel this op enqueues right after).
+                for (int r = lid; r < n_ids_capture; r += wg_size) {
+                    const int32_t hit = local_hit_slot[r];
+                    remapped_ids[r] = (hit >= 0) ? hit : local_unique_miss[local_route_owner[r]];
+                }
+
+                item.barrier(sycl::access::fence_space::global_and_local);
+
+            });
+    });
+
+    if (ggml_sycl_moe_cache_profile_enabled()) {
+        const auto t0 = std::chrono::steady_clock::now();
+        compute_q.wait();
+        const auto t1 = std::chrono::steady_clock::now();
+        g_moe_last_events[1] = moe_submit_gather_dispatch(compute_q, cold_base, pool_base, row_bytes,
+                                                          miss_expert, miss_slot, n_misses_dev, n_ids_per_group);
+        compute_q.wait();
+        const auto t2 = std::chrono::steady_clock::now();
+
+        int32_t n_miss_host = 0;
+        compute_q.memcpy(&n_miss_host, n_misses_dev, sizeof(int32_t)).wait();
+
+        g_prof.plan_ms   += std::chrono::duration<double, std::milli>(t1 - t0).count();
+        g_prof.gather_ms += std::chrono::duration<double, std::milli>(t2 - t1).count();
+        g_prof.misses    += (uint64_t) (n_miss_host > 0 ? n_miss_host : 0);
+        g_prof.routes    += (uint64_t) n_ids_per_group;
+        g_prof.n_calls   += 1;
+
+        g_moe_last_events[0]   = plan_event;
+        g_moe_last_event_count = 2;
+        return remapped_ids;
+    }
+
+    g_moe_last_events[0]   = plan_event;
+    g_moe_last_events[1]   = moe_submit_gather_dispatch(compute_q, cold_base, pool_base, row_bytes,
+                                                        miss_expert, miss_slot, n_misses_dev, n_ids_per_group);
+    g_moe_last_event_count = 2;
+
+    return remapped_ids;
+}
diff --git a/ggml/src/ggml-sycl/moe-cache.hpp b/ggml/src/ggml-sycl/moe-cache.hpp
new file mode 100644
index 000000000..1485adbe6
--- /dev/null
+++ b/ggml/src/ggml-sycl/moe-cache.hpp
@@ -0,0 +1,207 @@
+//
+// SYCL port of GenerelSchwerz/llama.cpp's CUDA MoE expert cache -- Phase 2:
+// the cold-tier pinned-host buffer type only. No dispatch/admission logic
+// here (that's Phase 3's ggml_sycl_mul_mat_id hook + a free-standing device
+// slot-pool cache struct, mirroring the CUDA fork's actual architecture --
+// see the module comment in moe-cache.cpp for why the buffer type does NOT
+// itself own any VRAM).
+//
+#ifndef GGML_SYCL_MOE_CACHE_HPP
+#define GGML_SYCL_MOE_CACHE_HPP
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <sycl/sycl.hpp>
+#include <cstdint>
+
+// Cold-tier buffer type for cached MoE expert weights: functionally a
+// SYCL pinned-host buffer (sycl::malloc_host), chunked to <=2 GiB per
+// underlying allocation (via get_max_size(), which ggml's own
+// ggml_backend_alloc_ctx_tensors_from_buft_impl already respects by
+// splitting a context's tensors across multiple buffers -- no custom
+// slab->(chunk,offset) bookkeeping needed). is_host() is hardcoded false
+// so the ggml scheduler does NOT route ops on these tensors straight to
+// the CPU backend; Phase 3's dispatch hook needs first refusal so it can
+// intercept MUL_MAT_ID for cache-aware execution instead.
+ggml_backend_buffer_type_t ggml_backend_sycl_moe_cached_buffer_type(void);
+
+// Identity check, mirroring ggml_backend_buft_is_cuda_moe_cached in the
+// reference fork and ggml_backend_buffer_is_sycl/_is_sycl_split in this
+// file's own ggml-sycl.cpp -- compares the get_name function pointer.
+bool ggml_backend_buft_is_sycl_moe_cached(ggml_backend_buffer_type_t buft);
+
+// Exposed through ggml_backend_dev_get_extra_bufts so --override-tensor can
+// name this type by its get_name() string ("SYCL_MoE_Cached") without any
+// dedicated CLI flag -- see src/llama-model.cpp's make_gpu_buft_list and
+// common/arg.cpp's parse_tensor_buffer_overrides, both of which already
+// walk a device's extra bufts list for exactly this purpose.
+ggml_backend_buffer_type_t * ggml_backend_sycl_moe_cached_get_extra_bufts(ggml_backend_dev_t dev);
+
+// ---------------------------------------------------------------------------
+// Phase 3a: legacy (host round-trip) dispatch hook, decode-only.
+//
+// One sycl_moe_cache per cached expert tensor (ffn_gate_exps/ffn_up_exps/
+// ffn_down_exps at a given layer each get their own independent slot pool
+// and LRU state, lazily created on first use) -- mirrors the reference
+// fork's "created lazily by the dispatch hook on first cached-tensor
+// access" buffer-type comment (moe-cache.cpp Phase 2 section), just for the
+// hot tier instead of the buffer type itself.
+//
+// Deliberately NOT thread-safe beyond a single mutex serializing all cache
+// access -- llama.cpp's compute graph execution for a single context is
+// single-threaded from ggml's perspective (thread pool parallelism is
+// intra-op, not concurrent multi-op dispatch), so this is not a real
+// contention point; simplicity was chosen over a lock-free design because
+// "plain LRU" is the explicit Phase 3a scope (PLAN.md), not the frequency-
+// decay device-side admission planner that's Phase 3b's job.
+struct sycl_moe_cache;
+
+// Get or lazily create the cache for this exact tensor (keyed by pointer
+// identity -- one ggml_tensor per layer per expert-projection, stable for
+// the lifetime of the loaded model). slot_count is read once, at creation,
+// from GGML_SYCL_MOE_CACHE_SIZE (default below) -- not a real CLI flag yet,
+// see this file's .cpp for why.
+sycl_moe_cache * ggml_sycl_moe_cache_get_or_create(const ggml_tensor * src0, sycl::queue & compute_q);
+
+// Acquire a device-resident slot for one expert. On a cache hit, returns
+// immediately with no event appended (the slot's last write was already
+// ordered against the compute queue by a prior ggml_sycl_moe_cache_barrier
+// call -- SYCL queues are in-order, so once that ordering has been
+// established once, later reads need no new synchronization). On a miss,
+// issues an async H2D copy on the cache's own dedicated copy queue and
+// appends its completion event to `miss_events`. Does not block.
+void * ggml_sycl_moe_cache_acquire(sycl_moe_cache * cache, int32_t expert_id, const void * host_ptr, size_t nbytes,
+                                    std::vector<sycl::event> & miss_events);
+
+// Makes `compute_q` wait on every event in `miss_events` before it runs
+// anything submitted after this call, via a cross-queue
+// ext_oneapi_submit_barrier -- a device-side dependency, not a host-blocking
+// wait, matching PLAN.md Phase 3a's own stated design (citing the
+// ggml-sycl.cpp reorder path as precedent for this exact API). No-op if
+// `miss_events` is empty (an all-hits op has nothing to wait for).
+void ggml_sycl_moe_cache_barrier(sycl::queue & compute_q, const std::vector<sycl::event> & miss_events);
+
+// The other half of the cross-queue dependency, easy to miss and correctness-
+// critical: ggml_sycl_moe_cache_barrier only orders "new copy -> compute
+// read" (compute must wait for a fresh H2D copy before reading it). Nothing
+// on its own stops the REVERSE hazard -- the copy queue overwriting a slot
+// (eviction) while a compute kernel from a PRIOR op is still reading that
+// slot's old contents, since the copy and compute queues are independent
+// and otherwise unordered with respect to each other. Call
+// mark_reads_submitted once after dispatching every row of an op that used
+// this cache; call wait_for_prior_reads once before that op's *next* use of
+// this cache (i.e. the next decode step touching the same tensor) starts
+// acquiring/evicting slots. Found by direct evidence, not by inspection:
+// an early version without this produced different greedy-decoded output
+// across repeated identical runs (temp 0, same seed) -- non-determinism is
+// the observable symptom of exactly this race.
+void ggml_sycl_moe_cache_mark_reads_submitted(sycl_moe_cache * cache, sycl::queue & compute_q);
+void ggml_sycl_moe_cache_wait_for_prior_reads(sycl_moe_cache * cache);
+
+// ---------------------------------------------------------------------------
+// Support for redirecting the existing grouped MoE GEMV kernels
+// (mul_mat_vec_q_moe / mul_mat_vec_q_moe_reorder in mmvq.cpp, reached via
+// ggml_sycl_mul_mat_id_mmvq_fused) through this cache's slot pool, instead of
+// writing a new kernel. Those kernels already do
+// `vx_base + ids_dev[expert_idx] * expert_weight_stride` entirely on-device,
+// one kernel launch handling every routed expert for the token -- if
+// `vx_base` is this cache's pool and `ids_dev` holds SLOT indices instead of
+// ORIGINAL expert indices, the kernels work correctly completely unmodified.
+void * ggml_sycl_moe_cache_pool_base(sycl_moe_cache * cache);
+size_t ggml_sycl_moe_cache_slot_stride(sycl_moe_cache * cache);
+
+// ---------------------------------------------------------------------------
+// Phase 3d: device-planned admission + gather.
+//
+// Phase 3a/3b decided admission from THIS token's exact routing, which
+// needed a host readback of this op's `ids` tensor before dispatch could
+// happen -- and on an in-order SYCL queue, `stream->wait()` for that
+// readback drains the ENTIRE queue built up so far, 144 times a token
+// (measured to dominate all of Phase 3a/3b's cost; see PLAN.md and the
+// phase3b-v2 log). Phase 3c tried to remove the readback by predicting
+// admission from stale/lagged frequency data and reading actual cache
+// misses directly from pinned host memory inside the compute kernel -- that
+// measured CATASTROPHICALLY slower than no cache at all (2.2-2.7 t/s on
+// Flash-Next vs. 3.8-5.2 t/s uncached), because fine-grained scattered
+// per-element host reads mixed into quantized-dot-product math are far more
+// expensive per byte than a bulk coalesced copy. Reading the reference CUDA
+// fork's actual grouped path (moe-cache.cu, see docs/research/03) showed
+// the real fix: it never reads this token's ids to host AT ALL, because the
+// ADMISSION DECISION ITSELF runs entirely on-device (a kernel that reads
+// the router's already-device-resident ids and updates slot assignments in
+// place, moe_grouped_plan_decode), and misses are serviced by a SEPARATE
+// dedicated bulk-copy kernel (moe_grouped_gather_decode, wide/coalesced,
+// no compute mixed in) -- never by scattered reads inside the GEMV kernel.
+// Both kernels launch back-to-back on the SAME in-order stream as the GEMV
+// kernel that follows, so correctness needs no explicit synchronization at
+// all: SYCL's in-order queue guarantee is the entire mechanism, same as
+// CUDA's same-stream launch-order guarantee.
+//
+// This phase ports that exact shape: a device planning kernel (persistent
+// per-expert decayed-frequency+age state, exactly mirroring the CUDA fork's
+// moe_grouped_effective_frequency formula) followed by a SEPARATE device
+// gather kernel, both enqueued back to back on `compute_q`.
+//
+// Getting there took three wrong turns, all of which came from optimizing
+// the planning kernel while the gather was the entire cost, and none of
+// which could be seen because the standalone benchmark used a 16 KiB
+// synthetic expert row (the real one is 589824 B) and timed calls with a
+// 50 ms-granularity host poll. With device-side event timestamps and a
+// real row size, the gather measured 10.263 ms per call against the plan's
+// 0.069 ms -- 1478 ms per token from the gather alone. The wrong turns, so
+// they are not retried:
+//   - Merging plan and gather into one kernel. It was adopted because two
+//     kernels measured slower, but that comparison also changed the plan
+//     scan from serial to parallel, so it never isolated launch cost. A
+//     pipelined kernel launch actually costs 3.0-4.0 us on this stack --
+//     ~0.5 ms per token across all 144 MoE ops, i.e. irrelevant.
+//   - Rewriting the admission reduction three times (hand-rolled shuffle,
+//     then sycl::reduce_over_group, then fewer barriers). All three measured
+//     identically because none of them touched the gather.
+//   - Keeping the gather inside the planning work-group at all. One
+//     work-group is one Xe core and cannot cover PCIe latency; the copy
+//     must be spread over a device-wide grid, which is only possible in a
+//     separate kernel, which is exactly why the CUDA reference has two.
+struct ggml_tensor;
+
+// Runs planning + gather for this op's routed experts and returns a device
+// pointer to a remapped (slot-index-per-route) int32 array of length
+// n_ids_per_group, ready to hand directly to the EXISTING, unmodified
+// ggml_sycl_mul_mat_vec_q_id/_reorder (mmvq.cpp) as `ids_dev`, with this
+// cache's pool as `vx_base` and slot_stride as `expert_weight_stride` --
+// exactly as Phase 3b already did, just with the remap now computed
+// on-device from this token's REAL ids instead of a host-side LRU scan. By
+// the time anything submitted on `compute_q` AFTER this call runs, every
+// routed expert for THIS token is guaranteed resident in the pool at the
+// returned slot indices: no cold-read fallback exists or is needed in this
+// design, unlike Phase 3c's hybrid kernel. `ids_dev` is this op's raw,
+// unmodified router ids (device pointer, untouched by host).
+const int32_t * ggml_sycl_moe_cache_plan_and_gather(sycl_moe_cache * cache, const ggml_tensor * src0,
+                                                     sycl::queue & compute_q, const int32_t * ids_dev,
+                                                     int n_ids_per_group);
+
+// Profiling hook, for the standalone benchmark only: the kernel events the
+// most recent ggml_sycl_moe_cache_plan_and_gather submitted, in submission
+// order (plan first, then gather when they are separate kernels). Only
+// meaningful if `compute_q` was built with enable_profiling; the production
+// dispatch path never calls this. Writes at most `max_out` events and
+// returns how many the call actually submitted.
+int ggml_sycl_moe_cache_debug_last_events(sycl::event * out, int max_out);
+
+// Profiling hook, standalone benchmark only: the unique-miss count the most
+// recent plan kernel recorded (blocking readback -- never call this from the
+// production dispatch path, which must stay free of host synchronization).
+int ggml_sycl_moe_cache_debug_n_misses(sycl_moe_cache * cache, sycl::queue & q);
+
+// Diagnostic stage profiler, GGML_SYCL_MOE_PROFILE=1 (off by default). It
+// DRAINS the queue between stages, so it makes the run slower than production
+// and its absolute t/s means nothing -- the per-stage split is the output.
+// See the implementation comment in moe-cache.cpp for why this exists.
+bool ggml_sycl_moe_cache_profile_enabled();
+void ggml_sycl_moe_cache_profile_add_gemv(double ms);
+void ggml_sycl_moe_cache_profile_first_call_marker(const char * where);
+void ggml_sycl_moe_cache_profile_note_decline();
+void ggml_sycl_moe_cache_profile_tick(int ops_per_token);
+
