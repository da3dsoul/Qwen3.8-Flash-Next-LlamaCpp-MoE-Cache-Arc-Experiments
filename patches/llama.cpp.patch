index 000000000..e89eed04e
--- /dev/null
+++ b/ggml/src/ggml-mmid-hybrid.h
@@ -0,0 +1,73 @@
+//
+// Hybrid CPU/GPU MUL_MAT_ID validation spike -- see
+// docs/research/05-hybrid-cpu-gpu-mul-mat-id-scoping.md, sections 4.6 and 6
+// ("Step 1 (spike)").
+//
+// THIS IS MEASUREMENT CODE, NOT A FEATURE. It exists to answer exactly one
+// question: what does one SYCL dispatch-and-host-wait round trip cost when
+// issued from CPU thread 0 inside ggml_compute_forward_mul_mat_id, and does
+// trading CPU-resident MoE expert rows to the GPU for concurrent compute
+// improve decode throughput on this hardware.
+//
+// Shape mirrors the reference fork's ggml-backend-moe-cache.h function-pointer
+// table (§2.1 of the scoping doc), minus begin/plan/end -- the spike has no
+// cache, no slot table and no admission policy, so there is nothing to plan and
+// nothing to release. The table lives in ggml-base so that ggml-cpu (C) can
+// call into ggml-sycl (C++) without either linking against the other; a backend
+// that never registers leaves it zero-initialized and every call site
+// null-checks, exactly as the reference design does.
+//
+#ifndef GGML_MMID_HYBRID_H
+#define GGML_MMID_HYBRID_H
+
+#include "ggml.h"
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Hard cap on rows handed to one dispatch. Matches the reference fork's
+// MOE_CACHE_MAX_TOPK so the stack arrays in ggml-cpu.c stay bounded; for
+// qwen4exp (n_expert_used == 10) this is 6 tokens per ubatch.
+#define GGML_MMID_HYBRID_MAX_ROWS 64
+
+struct ggml_mmid_hybrid_api {
+    // Submit GPU work for n_rows routed rows of one CPU-resident MUL_MAT_ID node.
+    //   act_rows[i]  host F32 activation row, src0->ne[0] floats
+    //   expert_ids[i] expert index, [0, src0->ne[2])
+    //   dst_rows[i]  host F32 destination row, src0->ne[1] floats (written by collect)
+    // Returns 1 only after the GPU has taken ownership of all n_rows: the caller
+    // must then omit those rows from CPU work and must call collect(). Returns 0
+    // on any decline, in which case nothing was written and the caller keeps the
+    // stock CPU path for every row.
+    // Called from CPU thread 0 only, in the serial ith == 0 prologue.
+    int (*dispatch)(const struct ggml_tensor * src0,
+                    int                        n_rows,
+                    const float * const *      act_rows,
+                    const int32_t *            expert_ids,
+                    float * const *            dst_rows);
+
+    // Host-wait for the work submitted by the matching dispatch(), then scatter
+    // the results into the dst_rows that dispatch() was given. Called from CPU
+    // thread 0 only, after the per-expert CPU loop, so the wait overlaps the
+    // other threads' miss rows (§4.4: max(GPU, CPU_misses) + latency).
+    void (*collect)(void);
+
+    // Usage-based static expert placement, docs/research/14 section 8. NULL
+    // unless a usage profile and VRAM budget were configured; when set, the
+    // caller sends exactly the rows this returns nonzero for (wherever they
+    // fall in iteration order) instead of dispatch's own fraction/prefix
+    // policy. Called from CPU thread 0 only, once per routed row, before
+    // building the row set passed to dispatch().
+    int (*resident)(const struct ggml_tensor * src0, int32_t expert_id);
+};
+
+GGML_API struct ggml_mmid_hybrid_api ggml_mmid_hybrid;
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // GGML_MMID_HYBRID_H
