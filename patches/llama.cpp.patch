diff --git a/ggml/src/ggml-sycl/hyper_connect.cpp b/ggml/src/ggml-sycl/hyper_connect.cpp
new file mode 100644
index 000000000..c61e4d3ba
--- /dev/null
+++ b/ggml/src/ggml-sycl/hyper_connect.cpp
@@ -0,0 +1,112 @@
+#include "hyper_connect.hpp"
+
+// See hyper_connect.hpp for what these two kernels replace.
+//
+// Both accumulate in the same order as the op chain they stand in for, so the result
+// is bit-identical to the unfused path, not just mathematically equal.
+
+static constexpr int HC_BLOCK = 256;
+
+static void hc_stream_mean_f32(const float * __restrict__ gated, float * __restrict__ dst,
+                               const int64_t n_embd, const int64_t nt, const int64_t hc,
+                               const int64_t g_s1, const int64_t d_s1, const float scale,
+                               const sycl::nd_item<1> & item) {
+    const int64_t i = item.get_global_linear_id();
+    if (i >= n_embd * nt) {
+        return;
+    }
+    const int64_t t = i / n_embd;
+    const int64_t e = i - t * n_embd;
+
+    const float * g = gated + t * g_s1 + e;
+
+    float sum = g[0];
+    for (int64_t c = 1; c < hc; ++c) {
+        sum += g[c * n_embd];
+    }
+    dst[t * d_s1 + e] = sum * scale;
+}
+
+// no __restrict__ here: ggml-alloc may place dst on top of res (a plain in-place add),
+// which the matcher allows because every work item writes the element it just read
+static void hc_combine_f32(const float * res, const float * b,
+                           const float * inj, float * dst,
+                           const int64_t n_embd, const int64_t hc, const int64_t nt,
+                           const int64_t r_s1, const int64_t r_s2, const int64_t b_s1,
+                           const int64_t i_s1, const int64_t d_s1, const int64_t d_s2,
+                           const float inv_hc, const float gain,
+                           const sycl::nd_item<1> & item) {
+// the unfused chain rounds the product before the add; without this the compiler
+// contracts them into one fma and the result moves by an ulp
+#pragma clang fp contract(off)
+    const int64_t i = item.get_global_linear_id();
+    if (i >= n_embd * hc * nt) {
+        return;
+    }
+    const int64_t e = i % n_embd;
+    const int64_t c = (i / n_embd) % hc;
+    const int64_t t = i / (n_embd * hc);
+
+    const float sig = 1.0f / (1.0f + sycl::exp(-(inj[t * i_s1 + c] * inv_hc)));
+    const float w   = sig * gain;
+
+    dst[t * d_s2 + c * d_s1 + e] = res[t * r_s2 + c * r_s1 + e] + b[t * b_s1 + e] * w;
+}
+
+void ggml_sycl_op_hc_stream_mean(ggml_backend_sycl_context & ctx, const ggml_tensor * gated,
+                                 ggml_tensor * dst, int64_t n_embd, int64_t hc, float scale) {
+    GGML_ASSERT(gated->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(gated->ne[0] == n_embd * hc);
+
+    const int64_t nt = dst->ne[1];
+    const int64_t g_s1 = gated->nb[1] / sizeof(float);
+    const int64_t d_s1 = dst->nb[1] / sizeof(float);
+
+    const float * g_dd = static_cast<const float *>(gated->data);
+    float *       d_dd = static_cast<float *>(dst->data);
+
+    const int64_t total  = n_embd * nt;
+    const int64_t blocks = (total + HC_BLOCK - 1) / HC_BLOCK;
+
+    dpct::queue_ptr stream = ctx.stream();
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(blocks * HC_BLOCK), sycl::range<1>(HC_BLOCK)),
+        [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            hc_stream_mean_f32(g_dd, d_dd, n_embd, nt, hc, g_s1, d_s1, scale, item);
+        });
+}
+
+void ggml_sycl_op_hc_combine(ggml_backend_sycl_context & ctx, const ggml_tensor * residual,
+                             const ggml_tensor * block_out, const ggml_tensor * inject,
+                             ggml_tensor * dst, float inv_hc, float gain) {
+    GGML_ASSERT(residual->type == GGML_TYPE_F32 && block_out->type == GGML_TYPE_F32);
+    GGML_ASSERT(inject->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+
+    const int64_t n_embd = dst->ne[0];
+    const int64_t hc     = dst->ne[1];
+    const int64_t nt     = dst->ne[2];
+
+    const int64_t r_s1 = residual->nb[1] / sizeof(float);
+    const int64_t r_s2 = residual->nb[2] / sizeof(float);
+    // block_out is [n_embd, 1, nt]: its per-token step is nb[2], not nb[1]
+    const int64_t b_s1 = block_out->nb[2] / sizeof(float);
+    const int64_t i_s1 = inject->nb[1] / sizeof(float);
+    const int64_t d_s1 = dst->nb[1] / sizeof(float);
+    const int64_t d_s2 = dst->nb[2] / sizeof(float);
+
+    const float * r_dd = static_cast<const float *>(residual->data);
+    const float * b_dd = static_cast<const float *>(block_out->data);
+    const float * i_dd = static_cast<const float *>(inject->data);
+    float *       d_dd = static_cast<float *>(dst->data);
+
+    const int64_t total  = n_embd * hc * nt;
+    const int64_t blocks = (total + HC_BLOCK - 1) / HC_BLOCK;
+
+    dpct::queue_ptr stream = ctx.stream();
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(blocks * HC_BLOCK), sycl::range<1>(HC_BLOCK)),
+        [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            hc_combine_f32(r_dd, b_dd, i_dd, d_dd, n_embd, hc, nt,
+                           r_s1, r_s2, b_s1, i_s1, d_s1, d_s2, inv_hc, gain, item);
+        });
+}
diff --git a/ggml/src/ggml-sycl/hyper_connect.hpp b/ggml/src/ggml-sycl/hyper_connect.hpp
new file mode 100644
index 000000000..0b24f3ac7
--- /dev/null
+++ b/ggml/src/ggml-sycl/hyper_connect.hpp
@@ -0,0 +1,25 @@
+#ifndef GGML_SYCL_HYPER_CONNECT_HPP
+#define GGML_SYCL_HYPER_CONNECT_HPP
+
+#include "common.hpp"
+
+// Fused hyper-connection glue for qwen4exp (Qwen3.8-Flash-Next). The model keeps hc
+// parallel residual streams and mixes them around every layer, which the graph spells
+// out as many tiny elementwise ops. At decode each one moves at most hc*n_embd floats,
+// so the launch costs far more than the work: fold each pattern into one kernel.
+// The matchers live in ggml-sycl.cpp next to the other graph fusions.
+
+// mean of the hc streams, hc*n_embd rows collapsed to n_embd:
+//   dst[e, t] = scale * sum_c gated[c*n_embd + e, t]
+// replaces cont + (hc-1) x add + scale
+void ggml_sycl_op_hc_stream_mean(ggml_backend_sycl_context & ctx, const ggml_tensor * gated,
+                                 ggml_tensor * dst, int64_t n_embd, int64_t hc, float scale);
+
+// scatter one block output back over the hc streams:
+//   dst[e, c, t] = residual[e, c, t] + block_out[e, t] * gain * sigmoid(inject[c, t] * inv_hc)
+// replaces scale + sigmoid + scale + repeat + mul + add
+void ggml_sycl_op_hc_combine(ggml_backend_sycl_context & ctx, const ggml_tensor * residual,
+                             const ggml_tensor * block_out, const ggml_tensor * inject,
+                             ggml_tensor * dst, float inv_hc, float gain);
+
+#endif  // GGML_SYCL_HYPER_CONNECT_HPP
diff --git a/ggml/src/ggml-sycl/mmid-hybrid.cpp b/ggml/src/ggml-sycl/mmid-hybrid.cpp
new file mode 100644
index 000000000..7c04bad40
--- /dev/null
+++ b/ggml/src/ggml-sycl/mmid-hybrid.cpp
@@ -0,0 +1,511 @@
+//
+// SYCL provider for the hybrid CPU/GPU MUL_MAT_ID validation spike.
+//
+// docs/research/05-hybrid-cpu-gpu-mul-mat-id-scoping.md section 4.6 lists what
+// a spike must build, and this file is that list:
+//
+//   1. a private in-order sycl::queue, same context and device as the backend
+//      compute queue, captured once at backend init and owned in a global
+//   2. a dispatch-shaped function that takes n F32 activation row pointers plus
+//      n expert indices, H2D's them, runs quantize_row_q8_1_sycl and then
+//      ggml_sycl_mul_mat_vec_q_id against the ORIGINAL src0->data (no cache, no
+//      slot table, expert_weight_stride = src0->nb[2], raw expert ids), D2H's
+//      the result, waits, and scatters
+//   3. instrumentation: the round trip cost is the deliverable, not the feature
+//
+// Deliberately NOT here: any cache, admission or eviction policy, fill path,
+// fused gate+up+SwiGLU, buffer type, or persistence. Those are steps 2-4 of the
+// doc's plan and only make sense once this file's number exists.
+//
+// Thread rules (section 4.2 of the doc): every entry point below runs on CPU
+// thread 0 only, which is the same OS thread that ran SYCL init. Nothing here
+// calls dpct::get_current_device() or dpct::get_default_queue(), because those
+// are keyed on the calling thread and silently resolve to DEFAULT_DEVICE_ID on
+// a thread that never called select_device. The queue is captured once, at
+// init, and used explicitly.
+//
+
+#include "mmid-hybrid.hpp"
+
+#include "../ggml-mmid-hybrid.h"
+
+#include "expert-pool.hpp"
+#include "ggml-impl.h"
+#include "common.hpp"
+#include "mmvq.hpp"
+#include "presets.hpp"
+#include "quantize.hpp"
+#include "dpct/helper.hpp"
+
+#include <sycl/sycl.hpp>
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <unordered_map>
+#include <vector>
+
+namespace {
+
+using clk = std::chrono::steady_clock;
+
+static double us_since(const clk::time_point & t) {
+    return std::chrono::duration<double, std::micro>(clk::now() - t).count();
+}
+
+struct mmid_hybrid_stats {
+    uint64_t n_dispatch   = 0;
+    uint64_t n_rows       = 0;
+    double   submit_us    = 0.0;   // host time to enqueue the whole chain
+    double   wait_us      = 0.0;   // host time blocked on the completion event
+    double   scatter_us   = 0.0;   // host time copying results into dst rows
+    double   rt_min_us    = 1e30;  // round trip = gather + submit + wait + scatter
+    double   rt_max_us    = 0.0;
+    double   rt_sum_us    = 0.0;
+
+    void reset() { *this = mmid_hybrid_stats(); }
+};
+
+struct mmid_hybrid_state {
+    sycl::queue   q;                      // private, in-order, backend context+device
+    sycl::context ctx;
+    bool          ok = false;
+
+    explicit mmid_hybrid_state(sycl::queue qq) : q(std::move(qq)), ctx(q.get_context()) {}
+
+    // staging, grown but never shrunk
+    float *   h_act = nullptr;            // pinned host [cap_rows * cap_ncols]
+    float *   h_dst = nullptr;            // pinned host [cap_rows * cap_nrows_out]
+    int32_t * h_ids = nullptr;            // pinned host [cap_rows]
+    float *   d_act = nullptr;
+    float *   d_dst = nullptr;
+    int32_t * d_ids = nullptr;
+    char *    d_q8  = nullptr;
+
+    int    cap_rows     = 0;
+    int    cap_ncols    = 0;
+    int    cap_nrows_out= 0;
+    size_t cap_q8_bytes = 0;
+
+    // in-flight node state (thread 0 only, one node at a time)
+    sycl::event         ev;
+    int                 n_pending  = 0;
+    int                 nrows_out  = 0;
+    float * const *     dst_rows   = nullptr;
+    clk::time_point     t_node;
+
+    // per-src0 eligibility, keyed on the weight base pointer. A GPU kernel can
+    // only read src0->data if it is device accessible; plain malloc'd CPU
+    // memory is not, and sycl::get_pointer_type is the only honest test.
+    std::unordered_map<const void *, bool> usable;
+
+    mmid_hybrid_stats stats;
+    int    window      = 0;
+    bool   calibrated  = false;
+
+    // calibration mirror: a device copy of the experts the first hooked node
+    // routed, kept alive so the same chain can be re-timed while decode runs.
+    // Never used to produce output, so it is a stopwatch, not a cache.
+    const void *   cal_host_base = nullptr;
+    void *         mirror      = nullptr;
+    int32_t *      mids        = nullptr;
+    enum ggml_type cal_type    = GGML_TYPE_F32;
+    size_t         cal_stride  = 0;
+    int            cal_rows    = 0;
+    int            cal_ncols   = 0;
+    int            cal_nrows_out = 0;
+    int            recal_every = 0;
+    int            recal_iters = 0;
+};
+
+static mmid_hybrid_state * g_state = nullptr;
+
+static float mmid_hybrid_fraction() {
+    static const float f = getenv("GGML_SYCL_MMID_HYBRID_FRACTION")
+                               ? (float) atof(getenv("GGML_SYCL_MMID_HYBRID_FRACTION")) : 0.0f;
+    return f;
+}
+
+static int mmid_hybrid_window() {
+    // 78 hooked nodes per token at -ncmoe 26, so 780 is about 10 decode tokens
+    static const int w = getenv("GGML_SYCL_MMID_HYBRID_WINDOW")
+                             ? atoi(getenv("GGML_SYCL_MMID_HYBRID_WINDOW")) : 780;
+    return w;
+}
+
+static int mmid_hybrid_calibrate_iters() {
+    static const int n = getenv("GGML_SYCL_MMID_HYBRID_CALIBRATE")
+                             ? atoi(getenv("GGML_SYCL_MMID_HYBRID_CALIBRATE")) : 200;
+    return n;
+}
+
+static int mmid_hybrid_recal_every() {
+    static const int n = getenv("GGML_SYCL_MMID_HYBRID_RECAL")
+                             ? atoi(getenv("GGML_SYCL_MMID_HYBRID_RECAL")) : 780;
+    return n;
+}
+
+static int mmid_hybrid_recal_iters() {
+    static const int n = getenv("GGML_SYCL_MMID_HYBRID_RECAL_ITERS")
+                             ? atoi(getenv("GGML_SYCL_MMID_HYBRID_RECAL_ITERS")) : 30;
+    return n;
+}
+
+static bool ensure_capacity(mmid_hybrid_state * s, int n_rows, int ncols, int nrows_out) {
+    const bool grow_rows = n_rows    > s->cap_rows;
+    const bool grow_cols = ncols     > s->cap_ncols;
+    const bool grow_out  = nrows_out > s->cap_nrows_out;
+    if (!grow_rows && !grow_cols && !grow_out) {
+        return true;
+    }
+
+    const int rows = grow_rows ? n_rows    : s->cap_rows;
+    const int cols = grow_cols ? ncols     : s->cap_ncols;
+    const int outr = grow_out  ? nrows_out : s->cap_nrows_out;
+
+    const int    padded   = GGML_PAD(cols, MATRIX_ROW_PADDING);
+    const size_t q8_bytes = (size_t) rows * padded * sizeof(block_q8_1) / QK8_1;
+
+    // free everything and reallocate: this runs at most a couple of times per
+    // run (two distinct ne00 in a qwen4exp MoE block), not per token
+    if (s->h_act) { sycl::free(s->h_act, s->q); }
+    if (s->h_dst) { sycl::free(s->h_dst, s->q); }
+    if (s->h_ids) { sycl::free(s->h_ids, s->q); }
+    if (s->d_act) { sycl::free(s->d_act, s->q); }
+    if (s->d_dst) { sycl::free(s->d_dst, s->q); }
+    if (s->d_ids) { sycl::free(s->d_ids, s->q); }
+    if (s->d_q8)  { sycl::free(s->d_q8,  s->q); }
+
+    s->h_act = sycl::malloc_host<float>  ((size_t) rows * cols, s->q);
+    s->h_dst = sycl::malloc_host<float>  ((size_t) rows * outr, s->q);
+    s->h_ids = sycl::malloc_host<int32_t>((size_t) rows,        s->q);
+    s->d_act = sycl::malloc_device<float>  ((size_t) rows * cols, s->q);
+    s->d_dst = sycl::malloc_device<float>  ((size_t) rows * outr, s->q);
+    s->d_ids = sycl::malloc_device<int32_t>((size_t) rows,        s->q);
+    s->d_q8  = (char *) sycl::malloc_device(q8_bytes, s->q);
+
+    if (!s->h_act || !s->h_dst || !s->h_ids || !s->d_act || !s->d_dst || !s->d_ids || !s->d_q8) {
+        fprintf(stderr, "MMID_HYBRID: staging allocation failed, disabling\n");
+        s->ok = false;
+        return false;
+    }
+
+    // quantize_row_q8_1_sycl only writes cols/QK8_1 blocks per row, so the pad
+    // tail stays whatever the allocator left. Zero it once so a stray read can
+    // never see a NaN.
+    s->q.memset(s->d_q8, 0, q8_bytes).wait();
+
+    s->cap_rows      = rows;
+    s->cap_ncols     = cols;
+    s->cap_nrows_out = outr;
+    s->cap_q8_bytes  = q8_bytes;
+    return true;
+}
+
+// One GPU round trip, minus the host-side gather and scatter. Split out so the
+// calibration below can run exactly the same chain against different weight
+// bases. Returns the event for the final D2H.
+static sycl::event submit_chain(mmid_hybrid_state * s,
+                                enum ggml_type type, const void * w_base, size_t w_stride,
+                                const int32_t * ids_dev,
+                                int n_rows, int ncols, int nrows_out, bool * ok) {
+    const int    padded         = GGML_PAD(ncols, MATRIX_ROW_PADDING);
+    const size_t bytes_per_qrow = (size_t) padded * sizeof(block_q8_1) / QK8_1;
+
+    s->q.memcpy(s->d_act, s->h_act, (size_t) n_rows * ncols * sizeof(float));
+    quantize_row_q8_1_sycl<quantize_q8_1>(s->d_act, s->d_q8, ncols, n_rows, padded, &s->q);
+
+    *ok = ggml_sycl_mul_mat_vec_q_id(
+        type, w_base, s->d_q8, ids_dev, s->d_dst,
+        ncols, nrows_out, n_rows,
+        /*expert_weight_stride =*/ w_stride,
+        /*dst_row_stride       =*/ (size_t) nrows_out * sizeof(float),
+        /*src1_row_stride      =*/ bytes_per_qrow,
+        &s->q);
+
+    return s->q.memcpy(s->h_dst, s->d_dst, (size_t) n_rows * nrows_out * sizeof(float));
+}
+
+// Answers open question 1 of the scoping doc directly, once per run, before any
+// throughput number is taken. Three numbers, all submit-to-host-visible:
+//   (a) bare  - two tiny memcpys, no kernel: the floor cost of one host wait
+//   (b) host  - the real chain against src0->data where it actually lives
+//   (c) vram  - the same chain against a device copy of just the routed experts
+// (c) is the number the full design would get on a cache hit; it is calibration
+// only, freed immediately, and is not a cache.
+static void calibrate_setup(mmid_hybrid_state * s, const ggml_tensor * src0,
+                            int n_rows, int ncols, int nrows_out) {
+    s->cal_type      = src0->type;
+    s->cal_stride    = src0->nb[2];
+    s->cal_rows      = n_rows;
+    s->cal_ncols     = ncols;
+    s->cal_nrows_out = nrows_out;
+
+    s->mirror = sycl::malloc_device((size_t) n_rows * s->cal_stride, s->q);
+    s->mids   = sycl::malloc_device<int32_t>((size_t) n_rows, s->q);
+    if (!s->mirror || !s->mids) {
+        if (s->mirror) { sycl::free(s->mirror, s->q); s->mirror = nullptr; }
+        if (s->mids)   { sycl::free(s->mids,   s->q); s->mids   = nullptr; }
+        return;
+    }
+
+    std::vector<int32_t> seq(n_rows);
+    for (int i = 0; i < n_rows; i++) {
+        seq[i] = i;
+        s->q.memcpy((char *) s->mirror + (size_t) i * s->cal_stride,
+                    (const char *) src0->data + (size_t) s->h_ids[i] * s->cal_stride, s->cal_stride);
+    }
+    s->q.memcpy(s->mids, seq.data(), (size_t) n_rows * sizeof(int32_t)).wait();
+}
+
+// Re-times the same three chains, from wherever it is called:
+//   (a) bare  - two tiny memcpys, no kernel: the floor cost of one host wait
+//   (b) host  - the real chain against src0->data where it actually lives
+//   (c) vram  - the same chain against the device mirror, i.e. what the full
+//               cached design would pay on a hit
+// Called once at the first hooked node (start of decode, GPU mostly quiet) and
+// then every recal_every dispatches (steady-state decode, GPU contended).
+static void calibrate(mmid_hybrid_state * s, const void * host_base, int iters, const char * when) {
+    if (iters <= 0) {
+        return;
+    }
+    const int n_rows    = s->cal_rows;
+    const int ncols     = s->cal_ncols;
+    const int nrows_out = s->cal_nrows_out;
+
+    double bare_min = 1e30, bare_sum = 0.0;
+    for (int i = 0; i < iters; i++) {
+        const auto t0 = clk::now();
+        s->q.memcpy(s->d_ids, s->h_ids, sizeof(int32_t));
+        s->q.memcpy(s->h_dst, s->d_dst, sizeof(float)).wait();
+        const double us = us_since(t0);
+        bare_sum += us;
+        if (us < bare_min) { bare_min = us; }
+    }
+
+    double host_min = 1e30, host_sum = 0.0;
+    bool   ok = true;
+    for (int i = 0; i < iters; i++) {
+        const auto t0 = clk::now();
+        s->q.memcpy(s->d_ids, s->h_ids, (size_t) n_rows * sizeof(int32_t));
+        submit_chain(s, s->cal_type, host_base, s->cal_stride, s->d_ids,
+                     n_rows, ncols, nrows_out, &ok).wait();
+        const double us = us_since(t0);
+        host_sum += us;
+        if (us < host_min) { host_min = us; }
+    }
+
+    double vram_min = 1e30, vram_sum = 0.0;
+    bool   vram_ok  = false;
+    if (s->mirror && s->mids) {
+        for (int i = 0; i < iters; i++) {
+            const auto t0 = clk::now();
+            submit_chain(s, s->cal_type, s->mirror, s->cal_stride, s->mids,
+                         n_rows, ncols, nrows_out, &vram_ok).wait();
+            const double us = us_since(t0);
+            vram_sum += us;
+            if (us < vram_min) { vram_min = us; }
+        }
+    }
+
+    fprintf(stderr, "MMID_HYBRID: calibration [%s] %d rows, ncols %d, nrows_out %d, %d iters\n",
+                  when, n_rows, ncols, nrows_out, iters);
+    fprintf(stderr, "MMID_HYBRID:   [%s] bare  submit+wait  : min %7.1f us  mean %7.1f us\n",
+                  when, bare_min, bare_sum / iters);
+    fprintf(stderr, "MMID_HYBRID:   [%s] full chain, host w : min %7.1f us  mean %7.1f us  (ok=%d)\n",
+                  when, host_min, host_sum / iters, (int) ok);
+    if (vram_ok) {
+        fprintf(stderr, "MMID_HYBRID:   [%s] full chain, vram w : min %7.1f us  mean %7.1f us\n",
+                      when, vram_min, vram_sum / iters);
+    } else {
+        fprintf(stderr, "MMID_HYBRID:   [%s] full chain, vram w : not measured\n", when);
+    }
+}
+
+static void report(mmid_hybrid_state * s) {
+    const mmid_hybrid_stats & st = s->stats;
+    if (st.n_dispatch == 0) {
+        return;
+    }
+    const double n = (double) st.n_dispatch;
+    fprintf(stderr, "MMID_HYBRID: %llu dispatches, %.1f rows each | round trip mean %.1f us "
+                  "(min %.1f, max %.1f) = gather+submit %.1f + wait %.1f + scatter %.1f\n",
+                  (unsigned long long) st.n_dispatch, st.n_rows / n,
+                  st.rt_sum_us / n, st.rt_min_us, st.rt_max_us,
+                  st.submit_us / n, st.wait_us / n, st.scatter_us / n);
+    s->stats.reset();
+}
+
+static int mmid_hybrid_dispatch(const ggml_tensor * src0, int n_rows,
+                                const float * const * act_rows,
+                                const int32_t * expert_ids,
+                                float * const * dst_rows) {
+    mmid_hybrid_state * s = g_state;
+    if (s == nullptr || !s->ok || n_rows <= 0 || n_rows > GGML_MMID_HYBRID_MAX_ROWS) {
+        return 0;
+    }
+
+    const int ncols     = (int) src0->ne[0];
+    const int nrows_out = (int) src0->ne[1];
+    if (ncols % QK8_1 != 0) {
+        return 0;
+    }
+
+    // Static-pool mode (docs/research/14): the caller (ggml-cpu.c) already
+    // filtered expert_ids down to rows it confirmed resident, so the weights
+    // live in this tensor's own sycl::malloc_device pool, not at src0->data --
+    // no host-USM usability check needed, and no calibration against a base
+    // pointer we are not going to read.
+    const bool pool_mode = ggml_expert_pool_enabled();
+
+    if (!pool_mode) {
+        // src0->data must be device accessible. sycl::malloc_host memory is,
+        // plain malloc'd CPU memory is not. Checked once per weight tensor.
+        auto it = s->usable.find(src0->data);
+        if (it == s->usable.end()) {
+            const sycl::usm::alloc kind = sycl::get_pointer_type(src0->data, s->ctx);
+            const bool             good = kind == sycl::usm::alloc::host ||
+                                          kind == sycl::usm::alloc::shared ||
+                                          kind == sycl::usm::alloc::device;
+            if (!good) {
+                fprintf(stderr, "MMID_HYBRID: %s is not device accessible (usm kind %d), declining. "
+                              "Place the CPU-resident experts in SYCL_Host.\n",
+                              src0->name, (int) kind);
+            }
+            it = s->usable.emplace(src0->data, good).first;
+        }
+        if (!it->second) {
+            return 0;
+        }
+    }
+
+    const auto t_node = clk::now();
+
+    if (!ensure_capacity(s, n_rows, ncols, nrows_out)) {
+        return 0;
+    }
+
+    for (int i = 0; i < n_rows; i++) {
+        memcpy(s->h_act + (size_t) i * ncols, act_rows[i], (size_t) ncols * sizeof(float));
+        s->h_ids[i] = pool_mode ? ggml_expert_pool_slot(src0, expert_ids[i]) : expert_ids[i];
+    }
+
+    if (!pool_mode && !s->calibrated) {
+        s->calibrated = true;
+        calibrate_setup(s, src0, n_rows, ncols, nrows_out);
+        s->cal_host_base = src0->data;
+        calibrate(s, src0->data, mmid_hybrid_calibrate_iters(), "start of decode");
+    }
+
+    void * const  w_base   = pool_mode ? ggml_expert_pool_base(src0)   : (void *) src0->data;
+    const size_t  w_stride = pool_mode ? ggml_expert_pool_stride(src0) : src0->nb[2];
+
+    bool ok = true;
+    s->q.memcpy(s->d_ids, s->h_ids, (size_t) n_rows * sizeof(int32_t));
+    sycl::event ev = submit_chain(s, src0->type, w_base, w_stride, s->d_ids,
+                                  n_rows, ncols, nrows_out, &ok);
+    if (!ok) {
+        // unsupported quant type: nothing was written to dst, drain and decline
+        s->q.wait();
+        s->usable[src0->data] = false;
+        fprintf(stderr, "MMID_HYBRID: no mmvq id kernel for %s, declining\n", ggml_type_name(src0->type));
+        return 0;
+    }
+
+    s->ev        = ev;
+    s->n_pending = n_rows;
+    s->nrows_out = nrows_out;
+    s->dst_rows  = dst_rows;
+    s->t_node    = t_node;
+    s->stats.submit_us += us_since(t_node);
+    return 1;
+}
+
+static void mmid_hybrid_collect(void) {
+    mmid_hybrid_state * s = g_state;
+    if (s == nullptr || s->n_pending == 0) {
+        return;
+    }
+
+    const auto t0 = clk::now();
+    s->ev.wait();
+    const double wait_us = us_since(t0);
+
+    const auto t1 = clk::now();
+    for (int i = 0; i < s->n_pending; i++) {
+        memcpy(s->dst_rows[i], s->h_dst + (size_t) i * s->nrows_out,
+               (size_t) s->nrows_out * sizeof(float));
+    }
+    const double scatter_us = us_since(t1);
+
+    const double rt = std::chrono::duration<double, std::micro>(clk::now() - s->t_node).count();
+
+    mmid_hybrid_stats & st = s->stats;
+    st.n_dispatch++;
+    st.n_rows     += s->n_pending;
+    st.wait_us    += wait_us;
+    st.scatter_us += scatter_us;
+    st.rt_sum_us  += rt;
+    if (rt < st.rt_min_us) { st.rt_min_us = rt; }
+    if (rt > st.rt_max_us) { st.rt_max_us = rt; }
+
+    s->n_pending = 0;
+
+    if (s->window > 0 && (st.n_dispatch % (uint64_t) s->window) == 0) {
+        report(s);
+    }
+
+    if (s->recal_every > 0 && s->cal_host_base != nullptr &&
+        (st.n_dispatch % (uint64_t) s->recal_every) == 0) {
+        calibrate(s, s->cal_host_base, s->recal_iters, "in flight");
+    }
+}
+
+static int mmid_hybrid_resident_bridge(const struct ggml_tensor * src0, int32_t expert_id) {
+    return ggml_expert_pool_resident(src0, expert_id) ? 1 : 0;
+}
+
+} // namespace
+
+void ggml_sycl_mmid_hybrid_register(void) {
+    if (g_state != nullptr) {
+        return;
+    }
+    ggml_sycl_expert_pool_init();
+    const bool pool_enabled = ggml_expert_pool_enabled();
+    if (mmid_hybrid_fraction() <= 0.0f && !pool_enabled) {
+        // both mechanisms off: no queue, no allocation, table stays null
+        return;
+    }
+
+    try {
+        // Same context and device as the backend compute queue, plus in_order.
+        // moe-cache.cpp:218 builds its copy queue the same way but omits
+        // in_order; see that file for the note. Do not copy the omission.
+        sycl::queue & compute_q = dpct::dev_mgr::instance().get_device(0).default_queue();
+
+        g_state = new mmid_hybrid_state(
+            sycl::queue(compute_q.get_context(), compute_q.get_device(),
+                        sycl::property_list{ sycl::property::queue::in_order() }));
+        g_state->window      = mmid_hybrid_window();
+        g_state->recal_every = mmid_hybrid_recal_every();
+        g_state->recal_iters = mmid_hybrid_recal_iters();
+        g_state->ok          = true;
+
+        ggml_mmid_hybrid.dispatch = mmid_hybrid_dispatch;
+        ggml_mmid_hybrid.collect  = mmid_hybrid_collect;
+
+        if (pool_enabled) {
+            ggml_expert_pool_set_queue(&g_state->q);
+            ggml_mmid_hybrid.resident = mmid_hybrid_resident_bridge;
+        }
+
+        fprintf(stderr, "MMID_HYBRID: enabled, fraction %.3f, pool %s, report window %d dispatches\n",
+                      mmid_hybrid_fraction(), pool_enabled ? "on" : "off", g_state->window);
+    } catch (const sycl::exception & e) {
+        fprintf(stderr, "MMID_HYBRID: init failed (%s), staying disabled\n", e.what());
+        if (g_state) { g_state->ok = false; }
+    }
+}
diff --git a/ggml/src/ggml-sycl/mmid-hybrid.hpp b/ggml/src/ggml-sycl/mmid-hybrid.hpp
