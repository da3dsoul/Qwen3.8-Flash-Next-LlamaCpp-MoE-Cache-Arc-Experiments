+namespace {
+
+int moe_cache_configured_slot_count() {
+    // Not a real CLI flag yet -- --moe-expert-cache-size N in the reference
+    // fork sizes this per llama-server invocation; wiring a proper flag
+    // through common/arg.cpp -> llama_model_params needs its own pass (the
+    // tensor-placement side alone, extending -ot's buft_list via
+    // ggml_backend_dev_get_extra_bufts above, is a small, precedented
+    // change; a slot-count flag would need new plumbing all the way through
+    // to here). GGML_SYCL_MOE_CACHE_SIZE is the interim mechanism.
+    const char * env = getenv("GGML_SYCL_MOE_CACHE_SIZE");
+    int n = env ? atoi(env) : 0;
+    return n > 0 ? n : 64;
+}
+
+std::mutex g_moe_caches_registry_mu;
+std::unordered_map<const ggml_tensor *, std::unique_ptr<sycl_moe_cache>> g_moe_caches;
+
+} // namespace
+
+sycl_moe_cache * ggml_sycl_moe_cache_get_or_create(const ggml_tensor * src0, sycl::queue & compute_q) {
+    std::lock_guard<std::mutex> lock(g_moe_caches_registry_mu);
+    auto it = g_moe_caches.find(src0);
+    if (it != g_moe_caches.end()) {
+        return it->second.get();
+    }
+    // src0->nb[2] is the per-expert byte stride within this tensor -- same
+    // quantity the reference fork calls expert_stride. One cache per tensor
+    // means slot_stride is exact for that tensor, not padded to the
+    // model-wide largest-expert-slab the fork uses for its single global
+    // pool; simpler for a first pass, at the cost of not being able to share
+    // slot pools across differently-shaped expert tensors (not something
+    // Phase 3a needs).
+    const size_t stride = (size_t) src0->nb[2];
+    const int    slots  = moe_cache_configured_slot_count();
+    const int    n_as   = (int) src0->ne[2];
+    auto cache = std::make_unique<sycl_moe_cache>(compute_q, stride, slots, n_as);
+    sycl_moe_cache * raw = cache.get();
+    g_moe_caches.emplace(src0, std::move(cache));
+    return raw;
+}
+
+void * ggml_sycl_moe_cache_acquire(sycl_moe_cache * cache, int32_t expert_id, const void * host_ptr, size_t nbytes,
+                                    std::vector<sycl::event> & miss_events) {
+    std::lock_guard<std::mutex> lock(cache->mu);
+
+    auto it = cache->expert_to_slot.find(expert_id);
+    if (it != cache->expert_to_slot.end()) {
+        cache->slot_last_used[it->second] = ++cache->clock;
+        return (char *) cache->pool + (size_t) it->second * cache->slot_stride;
+    }
+
+    // Pick a victim: an empty slot if one exists, else the least-recently-used.
+    int victim = 0;
+    bool found_empty = false;
+    for (int i = 0; i < cache->n_slots && !found_empty; ++i) {
+        if (cache->slot_expert[i] == -1) {
+            victim = i;
+            found_empty = true;
+        }
+    }
+    if (!found_empty) {
+        uint64_t oldest = UINT64_MAX;
+        for (int i = 0; i < cache->n_slots; ++i) {
+            if (cache->slot_last_used[i] < oldest) {
+                oldest = cache->slot_last_used[i];
+                victim = i;
+            }
+        }
+        cache->expert_to_slot.erase(cache->slot_expert[victim]);
+    }
+
+    void * dst = (char *) cache->pool + (size_t) victim * cache->slot_stride;
+    miss_events.push_back(cache->copy_queue.memcpy(dst, host_ptr, nbytes));
+
+    cache->slot_expert[victim] = expert_id;
+    cache->slot_last_used[victim] = ++cache->clock;
+    cache->expert_to_slot[expert_id] = victim;
+    return dst;
+}
+
+void ggml_sycl_moe_cache_barrier(sycl::queue & compute_q, const std::vector<sycl::event> & miss_events) {
+    // REVERTED to a host-blocking wait -- an ext_oneapi_submit_barrier(events)
+    // version of this (compute queue depends on the copy events without the
+    // host blocking) was tried and twice produced non-deterministic greedy-
+    // decode output (temp 0, fixed seed, identical repeated runs diverging)
+    // even after also adding the reverse-direction dependency
+    // (wait_for_prior_reads/mark_reads_submitted below, which does not use
+    // compute_q here but is still in effect). Root cause not found in the
+    // time available -- every theory checked out (ctx.stream() resolves to
+    // the same in-order default queue for every call, so a stream-identity
+    // mismatch was ruled out) yet the bug reproduced anyway. Shipping an
+    // unverified synchronization scheme fails PLAN.md's own "correct, then
+    // fast" priority -- reverted to the version independently confirmed
+    // byte-identical against an isolated same-code-path baseline. Revisit
+    // with a proper SYCL event/queue trace before attempting this again.
+    GGML_UNUSED(compute_q);
+    if (miss_events.empty()) {
+        return;
+    }
+    for (sycl::event e : miss_events) {
+        e.wait();
+    }
+}
+
+void ggml_sycl_moe_cache_mark_reads_submitted(sycl_moe_cache * cache, sycl::queue & compute_q) {
+    std::lock_guard<std::mutex> lock(cache->mu);
+    cache->last_compute_event = compute_q.ext_oneapi_submit_barrier();
+    cache->has_last_compute_event = true;
+}
+
+void ggml_sycl_moe_cache_wait_for_prior_reads(sycl_moe_cache * cache) {
+    std::lock_guard<std::mutex> lock(cache->mu);
+    if (!cache->has_last_compute_event) {
+        return;
+    }
+    cache->copy_queue.ext_oneapi_submit_barrier({cache->last_compute_event});
+}
+
+void * ggml_sycl_moe_cache_pool_base(sycl_moe_cache * cache) {
+    return cache->pool;
+}
+
+size_t ggml_sycl_moe_cache_slot_stride(sycl_moe_cache * cache) {
+    return cache->slot_stride;
+}
+
+// Decayed-LFU score, computed inside the plan kernel: an expert's raw hit
+// count, halved once per elapsed "step" (one step = one plan_and_gather
+// call for this tensor, i.e. one token) since it was last touched, floored
+// to 0 once 32+ steps have passed. Directly mirrors the CUDA reference
+// fork's moe_grouped_effective_frequency (moe-cache.cu:2786-2795), except
+// using one step = one call instead of CUDA's 16-calls-per-epoch batching
+// -- a pure tuning difference (faster decay in token terms), not a
+// correctness one; lower score = more evictable.
+static inline uint32_t moe_plan_effective_frequency(uint32_t frequency, uint32_t touched_step, uint32_t now_step) {
+    const uint32_t elapsed = now_step - touched_step;
+    return elapsed < 32 ? (frequency >> elapsed) : 0;
+}
+
+// A per-slot eviction candidate, packed into a single uint64_t so
+// sycl::reduce_over_group can reduce it directly with the standard
+// sycl::minimum<uint64_t> operator -- this SYCL implementation's
+// reduce_over_group only accepts scalar-arithmetic types (confirmed by
+// compile error, not assumption: a custom struct + custom binary op, tried
+// first, was rejected with "requirement 'is_scalar_arithmetic<...>::value'
+// was not satisfied"). Bit layout, high to low: 4 bits rank (0=empty,
+// 1=occupied, 2=protected -- only 0-2 used, 4 bits for headroom), 32 bits
+// score (the full uint32_t decayed-frequency range, no truncation), 28 bits
+// slot index (>256M slots, far beyond any realistic cache size). Because
+// rank occupies the MOST significant bits, a plain numeric minimum over
+// this key reduction correctly implements "lowest rank first, tie-break by
+// lowest score" -- no custom comparator needed, which is exactly what lets
+// this fall into reduce_over_group's supported (scalar, standard-operator)
+// path instead of the unsupported custom-type path.
+static inline uint64_t moe_plan_pack_candidate(uint32_t rank, uint32_t score, int32_t slot) {
+    return ((uint64_t) rank << 60) | ((uint64_t) score << 28) | (uint64_t) (uint32_t) slot;
+}
+static inline int32_t moe_plan_unpack_slot(uint64_t key) {
+    return (int32_t) (key & 0x0FFFFFFFu);
+}
+
+// ---------------------------------------------------------------------------
+// The gather kernel.
+//
+// This is where essentially all of this op's cost lives: one MISS copies a
+// whole expert row out of the pinned cold tier into its VRAM slot, and on
+// the smoke-test model a row is 589824 B (Q4_K ffn_gate/up) or 720896 B
+// (Q5_K ffn_down). The version this replaces copied that ONE BYTE AT A TIME
+// from the planning kernel's SINGLE work-group.
+//
+// Measured on the Arc Pro B70 with the real 589824 B row (see
+// docker/moe_cache_buffer_test.cpp -- device-side SYCL event timestamps,
+// 100 calls, identical routing across variants), gather kernel only:
+//
+//   byte words, 1 work-group (the version replaced)  : 10.263 ms
+//   16 B words, 1 work-group                         :  2.239 ms
+//   byte words, device-wide grid                     :  0.574 ms
+//   16 B words, device-wide grid (this code)         :  0.123 ms
+//
+// Two independent factors, and they multiply out to 83x:
+//   - Word width (~4.7x). A 16-work-item sub-group issuing byte loads asks
+//     for 16 B per memory transaction; a PCIe read of a host-USM line wants
+//     far more. 8 B measured 0.129 ms and 4 B 0.176 ms, so 16 B -- which is
+//     also what CUDA's moe_grouped_gather_decode uses (uint4) -- is where
+//     the curve flattens.
+//   - Grid width (~18x). One work-group occupies one Xe core and cannot keep
+//     enough reads in flight to cover PCIe latency however wide each one is.
+//     Spreading the copy over a device-wide grid is only possible in a
+//     separate kernel, which is precisely why the CUDA reference has two
+//     (moe-cache.cu:3210-3271, launched over moe_grouped_transfer_blocks).
+namespace {
+
+// Bytes per copied word, matching CUDA's uint4. Clamped down automatically
+// when row_bytes or either base pointer is not that aligned, so this is a
+// ceiling rather than an assumption about the quant type.
+constexpr int k_moe_gather_word_bytes = 16;
+
+// Work-items per work-group in both kernels. For the planning kernel only
+// n_slots of them have a slot to examine, so a wider group just widens the
+// per-miss barrier; CUDA's moe_grouped_plan_threads picks 128 for the same
+// reason (moe-cache.cu:2696), and 32/128/256 measured 0.079/0.071/0.069 ms
+// here -- flat, so the reference's choice stands.
+//
+// Re-measured at Flash-Next's shape (512 experts, 10 routed, 96 slots) after
+// moving the miss loop's admission tables into work-group-local memory:
+// 32 measured 0.122 ms vs 128's 0.110 ms, i.e. one sub-group is WORSE, not
+// better, even with the loop's barriers reduced to local fences. Two things
+// this rules out, so they are not retried: the per-miss barriers were never
+// the cost (making them local_space changed nothing measurable), and neither
+// was reduction width. What is left is dependent global-memory latency
+// inside a kernel that is deliberately ONE work-group, which is inherent to
+// the single-block planner design this mirrors from the CUDA reference.
+// At 0.11 ms x 144 ops it is ~7 ms/token on Flash-Next -- real, but small
+// next to that model's ~120 ms/token, and not worth a redesign until the
+// much larger non-MoE cost above it is addressed.
+constexpr int k_moe_plan_wg_size   = 128;
+constexpr int k_moe_gather_wg_size = 256; // == CUDA's MOE_GROUPED_TRANSFER_THREADS
+
+sycl::event g_moe_last_events[2];
+int         g_moe_last_event_count = 0;
+
+// One word type per supported width. sycl::vec is deliberately avoided here:
+// a plain trivially-copyable aggregate of the right size gets the same wide
+// load/store from the vectorizer without dragging in vec's conversion
+// operators, and it makes the alignment contract obvious at the point of use.
+struct alignas(16) moe_word16 { uint32_t v[4]; };
+struct alignas(8)  moe_word8  { uint32_t v[2]; };
+
+template <typename word_t>
+sycl::event moe_submit_gather(sycl::queue & q, const char * cold_base, char * pool_base, size_t row_bytes,
+                               const int32_t * miss_expert, const int32_t * miss_slot, const int32_t * n_misses_dev,
+                               int max_misses) {
+    constexpr size_t word_bytes = sizeof(word_t);
+
+    const size_t words_per_miss  = row_bytes / word_bytes;
+    const size_t tail_bytes      = row_bytes - words_per_miss * word_bytes;
+    const int    wg_size         = k_moe_gather_wg_size;
+    const size_t blocks_per_miss = (words_per_miss + wg_size - 1) / wg_size;
+
+    // Sized to cover the worst case -- every route a miss -- because the
+    // actual miss count is only known on-device. This is what CUDA's
+    // moe_grouped_transfer_blocks does too (moe-cache.cu:2700), and groups
+    // with no work left exit on the n_misses read at the top.
+    const size_t n_wg = std::max<size_t>(1, blocks_per_miss * (size_t) max_misses);
+
+    return q.submit([&](sycl::handler & cgh) {
+        cgh.parallel_for(sycl::nd_range<1>(sycl::range<1>(n_wg * wg_size), sycl::range<1>(wg_size)),
+            [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                const int32_t n_misses = *n_misses_dev;
+                if (n_misses <= 0) {
+                    return;
+                }
+                const size_t lid       = item.get_local_id(0);
+                const size_t n_groups  = item.get_group_range(0);
+                const size_t total_blk = blocks_per_miss * (size_t) n_misses;
+
+                // Grid-stride over (miss, chunk) BLOCKS rather than over
+                // individual words: the integer division that maps a flat
+                // index back to a miss then happens once per work-group
+                // iteration instead of once per copied word.
+                for (size_t blk = item.get_group(0); blk < total_blk; blk += n_groups) {
+                    const size_t   miss  = blk / blocks_per_miss;
+                    const size_t   chunk = blk - miss * blocks_per_miss;
+                    const int32_t  eid   = miss_expert[miss];
+                    const int32_t  slot  = miss_slot[miss];
+                    const word_t * src   = (const word_t *) (cold_base + (size_t) eid  * row_bytes);
+                    word_t *       dst   = (word_t *)       (pool_base + (size_t) slot * row_bytes);
+
+                    const size_t idx = chunk * (size_t) wg_size + lid;
+                    if (idx < words_per_miss) {
+                        dst[idx] = src[idx];
+                    }
+                    // Rows whose byte count is not a whole number of words
+                    // (never the case for this model's quant types, but the
+                    // slot pool would silently hold a truncated expert if it
+                    // ever were) get their remainder copied by the first
+                    // chunk's first few work-items.
+                    if (tail_bytes != 0 && chunk == 0 && lid < tail_bytes) {
+                        const char * src_b = cold_base + (size_t) eid  * row_bytes + words_per_miss * word_bytes;
+                        char *       dst_b = pool_base + (size_t) slot * row_bytes + words_per_miss * word_bytes;
+                        dst_b[lid] = src_b[lid];
+                    }
+                }
+            });
+    });
+}
+
+sycl::event moe_submit_gather_dispatch(sycl::queue & q, const char * cold_base, char * pool_base, size_t row_bytes,
+                                        const int32_t * miss_expert, const int32_t * miss_slot,
+                                        const int32_t * n_misses_dev, int max_misses) {
+    int word_bytes = k_moe_gather_word_bytes;
+
+    // Both bases and the per-row stride must all be `word_bytes`-aligned for
+    // a wide word to be a legal (and on this hardware, actually fast) access:
+    // slot N of the pool sits at pool_base + N*row_bytes, so an unaligned
+    // row_bytes misaligns every odd slot even when the base is fine.
+    const uintptr_t cold_addr = (uintptr_t) cold_base;
+    const uintptr_t pool_addr = (uintptr_t) pool_base;
+    while (word_bytes > 1 &&
+           ((row_bytes % (size_t) word_bytes) != 0 ||
+            (cold_addr % (uintptr_t) word_bytes) != 0 ||
+            (pool_addr % (uintptr_t) word_bytes) != 0)) {
+        word_bytes /= 2;
+    }
+
+    switch (word_bytes) {
+        case 16: return moe_submit_gather<moe_word16>(q, cold_base, pool_base, row_bytes, miss_expert, miss_slot,
+                                                       n_misses_dev, max_misses);
+        case 8:  return moe_submit_gather<moe_word8>(q, cold_base, pool_base, row_bytes, miss_expert, miss_slot,
+                                                      n_misses_dev, max_misses);
+        case 4:  return moe_submit_gather<uint32_t>(q, cold_base, pool_base, row_bytes, miss_expert, miss_slot,
+                                                     n_misses_dev, max_misses);
+        default: return moe_submit_gather<char>(q, cold_base, pool_base, row_bytes, miss_expert, miss_slot,
+                                                 n_misses_dev, max_misses);
+    }
+}
+
