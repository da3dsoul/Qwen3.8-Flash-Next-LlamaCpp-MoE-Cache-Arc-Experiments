new file mode 100644
index 000000000..896a00561
--- /dev/null
+++ b/ggml/src/ggml-sycl/expert-pool.hpp
@@ -0,0 +1,43 @@
+//
+// Usage-based static per-expert placement -- docs/research/14, section 8
+// Phase 1. Modelled on moe-cache.cpp's per-tensor slot pool with the
+// admission/eviction policy deleted: placement is decided once, from an
+// offline usage profile, and never changes for the life of the process.
+//
+#ifndef GGML_SYCL_EXPERT_POOL_HPP
+#define GGML_SYCL_EXPERT_POOL_HPP
+
+#include "ggml.h"
+
+#include <sycl/sycl.hpp>
+#include <cstdint>
+
+// Parse GGML_SYCL_EXPERT_PROFILE (a "tensor_name,expert_id,count" CSV, the
+// same format ggml-cpu.c's GGML_MOE_EXPERT_PROFILE dumps) and
+// GGML_SYCL_EXPERT_VRAM_MIB (a total budget, split evenly across every
+// tensor named in the file -- see the .cpp for why an even split rather than
+// a byte-exact cross-tensor knapsack). No-op if either is unset or the file
+// fails to parse. Call once, from the same thread that will later call
+// ggml_expert_pool_resident (mirrors ggml_sycl_mmid_hybrid_register).
+void ggml_sycl_expert_pool_init(void);
+
+// True once init() found a usable profile and a positive budget. Pools
+// themselves are still created lazily, per tensor, on first use.
+bool ggml_expert_pool_enabled(void);
+
+// The queue used for the one-time pool allocation and fill. Must be set
+// before the first ggml_expert_pool_resident call reaches a new tensor.
+void ggml_expert_pool_set_queue(sycl::queue * q);
+
+// True if expert_id of this weight tensor is resident in the static pool.
+// Lazily creates and fills the tensor's pool on first call, synchronously,
+// from src0->data (already the fully loaded host tensor). Thread 0 only.
+bool ggml_expert_pool_resident(const struct ggml_tensor * src0, int32_t expert_id);
+
+// Valid only after ggml_expert_pool_resident has returned true at least once
+// for src0.
+void * ggml_expert_pool_base(const struct ggml_tensor * src0);
+size_t ggml_expert_pool_stride(const struct ggml_tensor * src0);
+int32_t ggml_expert_pool_slot(const struct ggml_tensor * src0, int32_t expert_id);
+
+#endif // GGML_SYCL_EXPERT_POOL_HPP
