+                    qsa_ph_name[i], us[i]/1000.0, us[i]/1000.0/n_dec);
+        }
+
+        std::fill(us, us + PH_COUNT, 0);
+        n_dec = 0;
+    }
+
+    ~qsa_prof_t() {
+        if (on && n_dec > 0) {
