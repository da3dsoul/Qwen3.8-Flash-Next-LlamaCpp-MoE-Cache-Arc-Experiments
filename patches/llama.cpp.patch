+// F32 weights keep their own mat-vec: the dequantize_mul_mat_vec template accumulates in
+// dfloat, which is half under GGML_SYCL_F16, and an unquantized matrix must not lose that
+// precision. One work group per row, float accumulation, any number of columns.
+static constexpr int MMV_F32_BLOCK = 256;
+
+static void mul_mat_vec_f32_f32(const float * __restrict__ x, const float * __restrict__ y,
+                                float * __restrict__ dst, const int64_t ncols, const int64_t nrows,
+                                const sycl::nd_item<1> & item) {
+    const int64_t row = item.get_group(0);
+    if (row >= nrows) {
+        return;
+    }
+
+    const float * xr = x + row * ncols;
+
+    float sum = 0.0f;
+    for (int64_t col = item.get_local_id(0); col < ncols; col += MMV_F32_BLOCK) {
+        sum += xr[col] * y[col];
+    }
+
+    sum = sycl::reduce_over_group(item.get_group(), sum, sycl::plus<float>());
+    if (item.get_local_id(0) == 0) {
+        dst[row] = sum;
+    }
+}
+
+static void mul_mat_vec_f32_f32_sycl(const void * vx, const float * y, float * dst,
+                                     const int64_t ncols, const int64_t nrows,
+                                     dpct::queue_ptr stream) {
+    const float * x = (const float *) vx;
+    stream->parallel_for(
+        sycl::nd_range<1>(sycl::range<1>(nrows * MMV_F32_BLOCK), sycl::range<1>(MMV_F32_BLOCK)),
+        [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+            mul_mat_vec_f32_f32(x, y, dst, ncols, nrows, item);
+        });
+}
