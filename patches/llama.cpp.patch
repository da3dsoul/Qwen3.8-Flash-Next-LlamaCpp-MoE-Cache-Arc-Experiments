 template <int qk, int qr, dequantize_kernel_t dequantize_kernel>
 static void dequantize_mul_mat_vec(const void * __restrict__ vx, const dfloat * __restrict__ y, float * __restrict__ dst, const int ncols, const int nrows,
                                    const sycl::nd_item<3> &item_ct1) {
@@ -2205,6 +2242,10 @@ void ggml_sycl_op_dequantize_mul_mat_vec(
                 dequantize_mul_mat_vec_q6_K_sycl(src0_dd_i, src1_ddf_i, dst_dd_i, ne00, row_diff, stream);
             }
             break;
+        case GGML_TYPE_F32:
+            // takes the raw f32 src1, never the half copy the quantized paths make
+            mul_mat_vec_f32_f32_sycl(src0_dd_i, src1_ddf_i, dst_dd_i, ne00, row_diff, stream);
+            break;
         case GGML_TYPE_F16:
             convert_mul_mat_vec_f16_sycl(src0_dd_i, src1_dfloat, dst_dd_i, ne00, row_diff, stream);
             break;
diff --git a/ggml/src/ggml-sycl/expert-pool.cpp b/ggml/src/ggml-sycl/expert-pool.cpp
new file mode 100644
index 000000000..70f385a2d
--- /dev/null
+++ b/ggml/src/ggml-sycl/expert-pool.cpp
@@ -0,0 +1,193 @@
+//
+// Usage-based static per-expert placement -- docs/research/14, section 8
+// Phase 1.
+//
+// Placement is decided once, from an offline usage profile, and never
+// changes: no admission, no eviction, no plan kernel, no cross-queue
+// barrier, no tensor re-pointing. Every tensor named in the profile gets its
+// own device pool (mirroring moe-cache.cpp's one-pool-per-tensor shape) sized
+// to an equal share of GGML_SYCL_EXPERT_VRAM_MIB, filled once with its
+// highest-ranked experts' rows, synchronously, on first use. A cross-tensor
+// byte-exact knapsack would need each tensor's real size before any tensor
+// has been loaded, which needs a loader-time hook this design deliberately
+// avoids (see docs/research/14 section 2.5) -- an even split is a one-line
+// simplification of that, safe (never exceeds the budget) even though it is
+// not perfectly value-optimal across tensors of different sizes.
+//
+
+#include "expert-pool.hpp"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace {
+
+struct expert_pool {
+    void *                pool   = nullptr; // sycl::malloc_device, n_resident * stride bytes
+    size_t                stride = 0;
+    std::vector<int32_t>  slot_for_expert; // size n_expert, -1 if not resident
+};
+
+std::mutex                                          g_mu;
+std::unordered_map<const ggml_tensor *, expert_pool> g_pools;
+
+// tensor name -> experts ranked by hit count, descending. Populated once at
+// init from the profile file; never touched again.
+std::unordered_map<std::string, std::vector<int32_t>> g_ranked_experts;
+size_t      g_budget_bytes_per_tensor = 0;
+bool        g_enabled                = false;
+sycl::queue * g_queue                = nullptr;
+
+void load_profile(const char * path) {
+    std::ifstream f(path);
+    if (!f) {
+        fprintf(stderr, "EXPERT_POOL: could not open profile %s, staying disabled\n", path);
+        return;
+    }
+
+    std::unordered_map<std::string, std::vector<std::pair<int32_t, int64_t>>> counts;
+    std::string line;
+    while (std::getline(f, line)) {
+        if (line.empty()) {
+            continue;
+        }
+        std::stringstream ss(line);
+        std::string tensor, eid_s, cnt_s;
+        if (!std::getline(ss, tensor, ',') || !std::getline(ss, eid_s, ',') || !std::getline(ss, cnt_s, ',')) {
+            continue;
+        }
+        counts[tensor].emplace_back((int32_t) atoi(eid_s.c_str()), (int64_t) atoll(cnt_s.c_str()));
+    }
+
+    for (auto & kv : counts) {
+        std::sort(kv.second.begin(), kv.second.end(),
+                  [](const std::pair<int32_t, int64_t> & a, const std::pair<int32_t, int64_t> & b) {
+                      return a.second > b.second;
+                  });
+        std::vector<int32_t> ranked;
+        ranked.reserve(kv.second.size());
+        for (const auto & p : kv.second) {
+            ranked.push_back(p.first);
+        }
+        g_ranked_experts.emplace(kv.first, std::move(ranked));
+    }
+}
+
+// Lazily creates and fills src0's pool from its own already-loaded host
+// data. Must be called with g_mu held. Returns the (possibly just-inserted)
+// entry; an entry with pool == nullptr means "not in the profile" or "fill
+// failed", both of which mean "nothing of this tensor is resident".
+expert_pool & get_or_create(const ggml_tensor * src0) {
+    auto it = g_pools.find(src0);
+    if (it != g_pools.end()) {
+        return it->second;
+    }
+
+    expert_pool & entry = g_pools[src0];
+
+    auto ranked_it = g_ranked_experts.find(src0->name);
+    if (ranked_it == g_ranked_experts.end() || g_queue == nullptr) {
+        return entry; // no profile entry for this tensor: nothing resident
+    }
+
+    const size_t stride     = (size_t) src0->nb[2];
+    const int    n_expert   = (int) src0->ne[2];
+    const int    n_resident = stride > 0 ? (int) std::min<size_t>(g_budget_bytes_per_tensor / stride,
+                                                                   ranked_it->second.size())
+                                          : 0;
+    if (n_resident <= 0) {
+        return entry;
+    }
+
+    void * pool = sycl::malloc_device(stride * (size_t) n_resident, *g_queue);
+    if (!pool) {
+        fprintf(stderr, "EXPERT_POOL: device allocation failed for %s (%d experts, %zu bytes/expert), "
+                      "leaving it fully CPU-resident\n",
+                      src0->name, n_resident, stride);
+        return entry;
+    }
+
+    entry.slot_for_expert.assign(n_expert, -1);
+    for (int slot = 0; slot < n_resident; ++slot) {
+        const int32_t eid = ranked_it->second[slot];
+        if (eid < 0 || eid >= n_expert) {
+            continue;
+        }
+        entry.slot_for_expert[eid] = slot;
+        g_queue->memcpy((char *) pool + (size_t) slot * stride,
+                        (const char *) src0->data + (size_t) eid * stride, stride);
+    }
+    g_queue->wait();
+
+    entry.pool   = pool;
+    entry.stride = stride;
+    fprintf(stderr, "EXPERT_POOL: %s: %d of %d experts resident (%.1f MiB)\n",
+                  src0->name, n_resident, n_expert, (double) n_resident * stride / (1024.0 * 1024.0));
+    return entry;
+}
+
+} // namespace
+
+void ggml_sycl_expert_pool_init(void) {
+    const char * profile_path = getenv("GGML_SYCL_EXPERT_PROFILE");
+    const char * vram_mib_env = getenv("GGML_SYCL_EXPERT_VRAM_MIB");
+    if (!profile_path || !vram_mib_env) {
+        return;
+    }
+
+    const long vram_mib = atol(vram_mib_env);
+    if (vram_mib <= 0) {
+        return;
+    }
+
+    load_profile(profile_path);
+    if (g_ranked_experts.empty()) {
+        return;
+    }
+
+    g_budget_bytes_per_tensor = (size_t) vram_mib * 1024 * 1024 / g_ranked_experts.size();
+    g_enabled                 = true;
+
+    fprintf(stderr, "EXPERT_POOL: enabled, %ld MiB total budget across %zu tensors (%zu bytes/tensor)\n",
+                  vram_mib, g_ranked_experts.size(), g_budget_bytes_per_tensor);
+}
+
+bool ggml_expert_pool_enabled(void) {
+    return g_enabled;
+}
+
+void ggml_expert_pool_set_queue(sycl::queue * q) {
+    g_queue = q;
+}
+
+bool ggml_expert_pool_resident(const ggml_tensor * src0, int32_t expert_id) {
+    if (!g_enabled) {
+        return false;
+    }
+    std::lock_guard<std::mutex> lock(g_mu);
+    const expert_pool & entry = get_or_create(src0);
+    return expert_id >= 0 && (size_t) expert_id < entry.slot_for_expert.size() &&
+           entry.slot_for_expert[expert_id] >= 0;
+}
+
+void * ggml_expert_pool_base(const ggml_tensor * src0) {
+    std::lock_guard<std::mutex> lock(g_mu);
+    return g_pools.at(src0).pool;
+}
+
+size_t ggml_expert_pool_stride(const ggml_tensor * src0) {
+    std::lock_guard<std::mutex> lock(g_mu);
+    return g_pools.at(src0).stride;
+}
+
+int32_t ggml_expert_pool_slot(const ggml_tensor * src0, int32_t expert_id) {
+    std::lock_guard<std::mutex> lock(g_mu);
+    return g_pools.at(src0).slot_for_expert.at(expert_id);
+}
