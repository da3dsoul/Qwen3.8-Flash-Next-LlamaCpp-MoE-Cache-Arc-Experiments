+// ---------------------------------------------------------------------------
+// Whole-graph per-op profiler (GGML_SYCL_OP_PROFILE=1), OFF by default.
+//
+// The MoE-cache stage profiler (GGML_SYCL_MOE_PROFILE) showed the cached MoE
+// path costs ~37 ms of a ~200 ms Flash-Next token, so ~160 ms/token lives
+// somewhere else in the graph entirely. This attributes that remainder to
+// individual ops. It drains the queue around every single node, so the run is
+// far slower than production and only the RELATIVE split is meaningful.
+namespace {
+
+struct sycl_op_prof_entry {
+    double   ms    = 0.0;
+    uint64_t calls = 0;
+};
+
+std::map<std::string, sycl_op_prof_entry> g_sycl_op_prof;
+// same windows, but keyed by graph-build call site (the cb() tensor name) so a
+// hot op can be traced back to the model code that emits it
+std::map<std::string, sycl_op_prof_entry> g_sycl_op_prof_site;
+uint64_t g_sycl_op_prof_graphs = 0;
+
+// 1 = drain the queue around every node (per-node GPU time, but a heavily
+//     distorted run)
+// 2 = time only the host-side dispatch call, never sync (undistorted: shows how
+//     much of a token goes into submitting work vs waiting for the GPU)
+int sycl_op_prof_mode() {
+    static const int mode = getenv("GGML_SYCL_OP_PROFILE") ? atoi(getenv("GGML_SYCL_OP_PROFILE")) : 0;
+    return mode;
+}
+
+bool sycl_op_prof_enabled() {
+    return sycl_op_prof_mode() != 0;
+}
+
+// mode 2 only: host time inside the dispatch loop, and the tail wait after it
+double   g_sycl_op_prof_submit_ms = 0.0;
+double   g_sycl_op_prof_wait_ms   = 0.0;
+
+// cb() names a tensor "<site>-<layer>"; ggml names an unnamed one "<op> (<src>)".
+// drop both tails so every layer of one call site lands in one bucket.
+std::string sycl_op_prof_site_name(const ggml_tensor * node) {
+    std::string name = node->name;
+    const size_t paren = name.find(" (");
+    if (paren != std::string::npos) {
+        name.resize(paren);
+    }
+    size_t end = name.size();
+    while (end > 0 && isdigit((unsigned char) name[end - 1])) {
+        end--;
+    }
+    if (end > 0 && end < name.size() && name[end - 1] == '-') {
+        name.resize(end - 1);
+    }
+    if (name.empty()) {
+        name = "<unnamed>";
+    }
+    return name;
+}
+
+void sycl_op_prof_dump(const char * title, const std::map<std::string, sycl_op_prof_entry> & m, size_t top) {
+    std::vector<std::pair<std::string, sycl_op_prof_entry>> v(m.begin(), m.end());
+    std::sort(v.begin(), v.end(), [](const auto & a, const auto & b) { return a.second.ms > b.second.ms; });
+    double   total = 0.0;
+    uint64_t calls = 0;
+    for (const auto & kv : v) {
+        total += kv.second.ms;
+        calls += kv.second.calls;
+    }
+    fprintf(stderr, "  %s (%zu buckets, %llu calls, %.1f ms):\n", title, v.size(), (unsigned long long) calls, total);
+    for (size_t i = 0; i < v.size() && i < top; i++) {
+        fprintf(stderr, "    %-40s %8.2f ms  (%.1f%%)  %llu calls\n",
+                v[i].first.c_str(), v[i].second.ms,
+                total > 0.0 ? 100.0 * v[i].second.ms / total : 0.0,
+                (unsigned long long) v[i].second.calls);
+    }
+}
+
+// RAII so the timer still fires on every `continue` in the dispatch loop's
+// many fusion early-outs -- a plain pair of calls around the body would miss
+// most of them.
+struct sycl_op_prof_scope {
+    ggml_backend_sycl_context *           ctx;
+    const ggml_tensor *                   node;
+    std::chrono::steady_clock::time_point t0;
+    bool                                  on;
+
+    sycl_op_prof_scope(ggml_backend_sycl_context * c, const ggml_tensor * n)
+        : ctx(c), node(n), on(sycl_op_prof_enabled()) {
+        if (on) {
+            if (sycl_op_prof_mode() == 1) {
+                ctx->stream()->wait();
+            }
+            t0 = std::chrono::steady_clock::now();
+        }
+    }
+    ~sycl_op_prof_scope() {
+        if (!on) {
+            return;
+        }
+        if (sycl_op_prof_mode() == 1) {
+            ctx->stream()->wait();
+        }
+        const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+        std::string key = ggml_op_name(node->op);
+        if (node->op == GGML_OP_MUL_MAT || node->op == GGML_OP_MUL_MAT_ID) {
+            key += std::string(" ") + ggml_type_name(node->src[0]->type);
+        }
+        auto & e = g_sycl_op_prof[key];
+        e.ms += ms;
+        e.calls++;
+
+        auto & s = g_sycl_op_prof_site[sycl_op_prof_site_name(node) + " [" + ggml_op_name(node->op) + "]"];
+        s.ms += ms;
+        s.calls++;
+    }
+};
+
+void sycl_op_prof_report() {
+    if (!sycl_op_prof_enabled()) {
+        return;
+    }
+    // WINDOWED, not cumulative: graph_compute is called once per SCHEDULER
+    // SPLIT, not once per token, and the first splits of a run are warmup and
+    // prefill -- one FLASH_ATTN_EXT over the whole prompt swamped a cumulative
+    // average so thoroughly that steady-state decode was invisible in it.
+    // the window is in splits, not tokens: fewer CPU fallbacks means fewer splits
+    // per token, so GGML_SYCL_OP_PROFILE_WINDOW tunes it per experiment
+    static const int window = getenv("GGML_SYCL_OP_PROFILE_WINDOW")
+                                  ? atoi(getenv("GGML_SYCL_OP_PROFILE_WINDOW")) : 400;
+    g_sycl_op_prof_graphs++;
+    if (window <= 0 || (g_sycl_op_prof_graphs % window) != 0) {
+        return;
+    }
+    fprintf(stderr, "OP_PROFILE(mode %d) window ending at split %llu, over %d splits\n",
+            sycl_op_prof_mode(), (unsigned long long) g_sycl_op_prof_graphs, window);
+    if (sycl_op_prof_mode() == 2) {
+        fprintf(stderr, "  host dispatch loop %.1f ms, tail wait %.1f ms\n",
+                g_sycl_op_prof_submit_ms, g_sycl_op_prof_wait_ms);
+    }
+    sycl_op_prof_dump("by op", g_sycl_op_prof, 25);
+    sycl_op_prof_dump("by call site", g_sycl_op_prof_site, 45);
+    g_sycl_op_prof.clear();
+    g_sycl_op_prof_site.clear();
+    g_sycl_op_prof_submit_ms = 0.0;
+    g_sycl_op_prof_wait_ms   = 0.0;
+}
