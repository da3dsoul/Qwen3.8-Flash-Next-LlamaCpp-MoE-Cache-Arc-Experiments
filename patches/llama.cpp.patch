+
+#ifndef GGML_SYCL_FATTN_SPARSE_HPP
+#define GGML_SYCL_FATTN_SPARSE_HPP
+
+#include "common.hpp"
+
+// Sparse flash attention: FLASH_ATTN_EXT op_params slot 4 (n_kv_max) promises that no mask row has
+// more than n_kv_max finite entries, so a call can work on those columns alone instead of on the
+// whole KV cache. The columns are gathered into a compact K/V/mask copy and the unmodified kernel
+// runs with an effective ne11, which is exact because softmax does not depend on column order.
+//
+// Only decode is handled (Q->ne[1] == 1): one compact copy needs one shared column set, which is
+// what a single query row gives.
+
+// number of compact KV rows for this call, 0 when it must stay dense
+int64_t ggml_sycl_fattn_sparse_rows(const ggml_tensor * dst);
+
+// the compact buffers plus the kernel arguments that describe them.
+// the scratch pool frees in reverse order of allocation, so declare the members in the order
+// ggml_sycl_fattn_sparse_gather() allocates them and declare the whole struct before any other
+// pool user of the calling scope.
+struct ggml_sycl_fattn_sparse_ctx {
+    explicit ggml_sycl_fattn_sparse_ctx(ggml_sycl_pool & pool) :
+        idx(pool), cnt(pool), tile_cnt(pool), K_q(pool), K_f16(pool), V_q(pool), V_f16(pool), mask_f16(pool) {}
+
+    ggml_sycl_pool_alloc<int32_t>     idx;      // [n_rows, ne33] gathered column index per compact row
+    ggml_sycl_pool_alloc<int32_t>     cnt;      // [ne33]         finite entries in the mask row
+    ggml_sycl_pool_alloc<int32_t>     tile_cnt;
+    ggml_sycl_pool_alloc<char>        K_q;
+    ggml_sycl_pool_alloc<sycl::half>  K_f16;
+    ggml_sycl_pool_alloc<char>        V_q;
+    ggml_sycl_pool_alloc<sycl::half>  V_f16;
+    ggml_sycl_pool_alloc<sycl::half>  mask_f16;
+
+    const char * K_data    = nullptr;
+    const char * V_data    = nullptr;
+    const char * mask_data = nullptr;
+
+    size_t nb11 = 0, nb12 = 0, nb13 = 0;
+    size_t nb21 = 0, nb22 = 0, nb23 = 0;
+    size_t nb31 = 0, nb32 = 0, nb33 = 0;
+};
+
+// fills sp with a compact copy of the finite-mask K/V rows. need_f16_* mirror the kernel's demand
+// for an f16 cache, exactly as the dense staging path uses them.
+void ggml_sycl_fattn_sparse_gather(ggml_backend_sycl_context & ctx, const ggml_tensor * dst, int64_t n_rows,
+                                   bool need_f16_K, bool need_f16_V, bool V_is_K_view,
+                                   ggml_sycl_fattn_sparse_ctx & sp);
+
+#endif // GGML_SYCL_FATTN_SPARSE_HPP
